.home-page {
  --page-bg: #fff7e8;
  --paper: #fffdf5;
  --paper-deep: #f8edd8;
  --ink: #49352d;
  --muted-ink: #806b60;
  --cover: #cf684b;
  --cover-deep: #a94736;
  position: relative;
  min-height: 100vh;
  padding: 30rpx 28rpx 190rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 92% 5%, rgba(244, 190, 80, 0.28), transparent 25%),
    radial-gradient(circle at 2% 38%, rgba(224, 126, 98, 0.12), transparent 21%),
    var(--page-bg);
  color: var(--ink);
}

.sky-decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(207, 104, 75, 0.13);
  pointer-events: none;
}

.sky-dot-one {
  top: 220rpx;
  right: 18rpx;
  width: 18rpx;
  height: 18rpx;
}

.sky-dot-two {
  top: 260rpx;
  right: 52rpx;
  width: 10rpx;
  height: 10rpx;
}

.recent-card {
  position: relative;
  z-index: 2;
  min-height: 164rpx;
  margin-top: 4rpx;
  padding: 24rpx 150rpx 24rpx 94rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 2rpx solid #efd7b2;
  border-radius: 28rpx;
  background: rgba(255, 253, 245, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(112, 70, 48, 0.1);
  box-sizing: border-box;
  transition: transform 180ms ease-out, box-shadow 180ms ease-out;
}

.bookmark-ribbon {
  position: absolute;
  top: 0;
  left: 24rpx;
  width: 54rpx;
  height: 116rpx;
  background: linear-gradient(90deg, #b93f3d 0%, #d45b50 52%, #b93f3d 100%);
  box-shadow: 0 6rpx 12rpx rgba(130, 51, 45, 0.18);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 79%, 0 100%);
}

.bookmark-ribbon::after {
  position: absolute;
  top: 0;
  left: 12rpx;
  width: 2rpx;
  height: 86rpx;
  background: rgba(255, 231, 190, 0.52);
  content: "";
}

.recent-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.recent-label {
  margin-bottom: 5rpx;
  color: #a94736;
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.recent-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 21rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.storybook-heading {
  margin: 40rpx 4rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.storybook-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 850;
  letter-spacing: 4rpx;
}

.book-stage {
  position: relative;
  height: 626rpx;
  padding: 18rpx 12rpx 34rpx;
  box-sizing: border-box;
}

.book-cover {
  position: absolute;
  left: 0;
  right: 0;
  top: 14rpx;
  bottom: 16rpx;
  border: 6rpx solid var(--cover-deep);
  border-radius: 34rpx 34rpx 44rpx 44rpx;
  background: var(--cover);
  box-shadow: 0 24rpx 38rpx rgba(92, 49, 34, 0.22);
}

.page-stack {
  position: absolute;
  z-index: 1;
  top: 24rpx;
  bottom: 30rpx;
  width: calc(50% - 14rpx);
  border: 2rpx solid #e6d3b5;
  background: #f6e8cf;
}

.page-stack-left {
  left: 12rpx;
  border-radius: 24rpx 6rpx 8rpx 32rpx;
  transform: rotate(-0.7deg);
}

.page-stack-right {
  right: 12rpx;
  border-radius: 6rpx 24rpx 32rpx 8rpx;
  transform: rotate(0.7deg);
}

.open-book {
  position: relative;
  z-index: 2;
  height: 566rpx;
  display: flex;
  overflow: hidden;
  border: 2rpx solid #ead7b8;
  border-radius: 28rpx 28rpx 34rpx 34rpx;
  background: var(--paper);
  box-shadow: inset 0 -14rpx 22rpx rgba(155, 108, 69, 0.08);
}

.book-page {
  min-width: 0;
  padding: 22rpx 18rpx;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
  background:
    repeating-linear-gradient(0deg, transparent 0, transparent 61rpx, rgba(174, 132, 91, 0.045) 62rpx),
    var(--paper);
}

.left-page {
  padding-right: 24rpx;
  border-radius: 26rpx 2rpx 2rpx 32rpx;
  box-shadow: inset -18rpx 0 24rpx rgba(121, 84, 54, 0.07);
}

.right-page {
  padding-left: 24rpx;
  border-radius: 2rpx 26rpx 32rpx 2rpx;
  box-shadow: inset 18rpx 0 24rpx rgba(121, 84, 54, 0.07);
}

.book-spine {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 34rpx;
  background: linear-gradient(90deg, rgba(96, 60, 39, 0.16), rgba(255, 255, 255, 0.5) 48%, rgba(96, 60, 39, 0.18));
  transform: translateX(-50%);
  pointer-events: none;
}

.spine-highlight {
  width: 2rpx;
  height: 100%;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.78);
}

.book-entry {
  position: relative;
  min-height: 0;
  padding: 16rpx 14rpx 14rpx;
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  box-sizing: border-box;
  transition: transform 180ms ease-out, background-color 180ms ease-out, box-shadow 180ms ease-out;
}

.entry-learn {
  border-color: #efd68d;
  background: #fff8df;
}

.entry-game {
  border-color: #b9ddb9;
  background: #f0faee;
}

.entry-original {
  border-color: #f0bdc5;
  background: #fff1f3;
}

.entry-profile {
  border-color: #b9d9eb;
  background: #eef8fd;
}

.entry-topline {
  position: absolute;
  z-index: 2;
  top: 12rpx;
  left: 14rpx;
  right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-number {
  color: #795f53;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.entry-corner {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  color: #9c5e46;
  font-size: 17rpx;
  font-weight: 750;
}

.entry-watermark {
  position: absolute;
  z-index: 1;
  right: -10rpx;
  bottom: -12rpx;
  width: 148rpx;
  height: 148rpx;
  opacity: 0.11;
  pointer-events: none;
  transform: rotate(-5deg);
}

.entry-title,
.entry-description {
  position: relative;
  z-index: 2;
}

.entry-title {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.2;
}

.entry-description {
  margin-top: 8rpx;
  color: #745e54;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: center;
}

.book-mark {
  position: absolute;
  z-index: 1;
  bottom: 4rpx;
  width: 34rpx;
  height: 88rpx;
  border-radius: 0 0 10rpx 10rpx;
  transform-origin: top center;
}

.book-mark-one {
  left: 29%;
  background: #eab949;
  transform: rotate(4deg);
}

.book-mark-two {
  right: 27%;
  background: #7db487;
  transform: rotate(-5deg);
}

.closing-note {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #927263;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.closing-flower {
  color: #cf684b;
  font-size: 24rpx;
}

.press-soft,
.recent-card-press,
.entry-press {
  opacity: 0.9;
  transform: scale(0.97);
}

.recent-card-press {
  box-shadow: 0 6rpx 18rpx rgba(112, 70, 48, 0.09);
}

@media (max-width: 340px) {
  .home-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .recent-card { padding-right: 136rpx; }
  .book-stage { height: 604rpx; }
  .open-book { height: 544rpx; }
  .book-page { padding-left: 12rpx; padding-right: 12rpx; }
  .left-page { padding-right: 19rpx; }
  .right-page { padding-left: 19rpx; }
  .book-entry { padding-left: 8rpx; padding-right: 8rpx; }
  .entry-title { font-size: 25rpx; }
  .entry-description { font-size: 18rpx; }
  .entry-watermark {
    right: -14rpx;
    bottom: -14rpx;
    width: 132rpx;
    height: 132rpx;
  }
}

@media (min-width: 600px) {
  .home-page {
    padding-left: 8vw;
    padding-right: 8vw;
  }

  .book-stage {
    height: 660rpx;
  }

  .open-book {
    height: 600rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .recent-card,
  .book-entry {
    transition: none;
  }
}

/* 社区和反馈入口 */
.extra-entries {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.extra-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  border: 2rpx solid #ead8bc;
  border-radius: 24rpx;
  background: #fffdf5;
  box-shadow: 0 8rpx 20rpx rgba(104, 66, 43, 0.07);
  transition: transform 180ms ease-out, box-shadow 180ms ease-out;
}

.extra-community {
  border-color: #b9ddb9;
  background: linear-gradient(135deg, #f0faee, #fffdf5);
}

.extra-feedback {
  border-color: #d4b8e8;
  background: linear-gradient(135deg, #f8f0fd, #fffdf5);
}

.extra-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.extra-icon image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.extra-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.extra-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #49352d;
}

.extra-desc {
  font-size: 21rpx;
  color: #7a655a;
  margin-top: 6rpx;
}
