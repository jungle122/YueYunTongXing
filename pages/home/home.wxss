
/* 背景与基础布局（小程序：使用 page 作为根视图，但此处加容器类） */
.yyth-home {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 32rpx 60rpx 32rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 用户卡片占位头像 */
.user-card { position: absolute; right: 32rpx; top: 32rpx; display:flex; align-items:center; gap: 12rpx; z-index: 2; flex-direction: row-reverse;
}
.avatar-fallback { width: 64rpx; height: 64rpx; border-radius: 50%; background: linear-gradient(45deg,#4facfe,#00f2fe); color:#fff; font-weight:700; font-size: 28rpx; display:flex; align-items:center; justify-content:center;
}
.avatar-img { width: 64rpx; height: 64rpx; border-radius: 50%; border: 2rpx solid rgba(255,255,255,0.3);
}
.nickname { color:#fff; font-weight:700; font-size: 28rpx;
}

/* 星星闪烁背景（用多层径向渐变模拟） */
.bg-stars {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-image:
    radial-gradient(6rpx 6rpx at 40rpx 60rpx, #ffffff, rgba(255,255,255,0)),
    radial-gradient(4rpx 4rpx at 80rpx 140rpx, rgba(255,255,255,0.8), rgba(255,255,255,0)),
    radial-gradient(8rpx 8rpx at 180rpx 80rpx, #ffffff, rgba(255,255,255,0)),
    radial-gradient(4rpx 4rpx at 260rpx 160rpx, rgba(255,255,255,0.6), rgba(255,255,255,0));
  background-repeat: repeat;
  background-size: 700rpx 400rpx;
  animation: starTwinkle-0cd09a48 4s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}
.floating-elements {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 0; pointer-events: none;
}
.glow-effects { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 0; pointer-events: none;
}
.glow { position: absolute; width: 200rpx; height: 200rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,215,0,0.25), rgba(255,215,0,0));
  animation: glowPulse-0cd09a48 4s ease-in-out infinite;
}
.glow-a { left: 80%; top: 20%; animation-delay: 0s;
}
.glow-b { left: 10%; bottom: 15%; animation-delay: 2s;
}
.header-section { padding: 40rpx 0 20rpx 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; position: relative; z-index: 1;
}
.main-title {
  font-size: 64rpx; font-weight: 900; color: #fff; letter-spacing: 6rpx;
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.5);
  animation: titleGlow-0cd09a48 3s ease-in-out infinite alternate;
}
.subtitle { margin-top: 16rpx; font-size: 28rpx; font-weight: 600; color: rgba(255, 255, 255, 0.9); animation: subtitleFloat-0cd09a48 4s ease-in-out infinite;
}
.nav-section { margin-top: 40rpx; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1;
}
.nav { width: 100%; max-width: 700rpx; display: grid; grid-template-columns: 1fr 1fr; grid-row-gap: 24rpx; grid-column-gap: 24rpx;
}
.nav-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 220rpx; padding: 30rpx 20rpx; border-radius: 30rpx; background: rgba(255, 255, 255, 0.15); border: 2rpx solid rgba(255, 255, 255, 0.28); box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.18), inset 0 2rpx 0 rgba(255,255,255,0.35); color: #fff;
}
.nav-emoji { font-size: 76rpx; margin-bottom: 18rpx; filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.3)); animation: emojiFloat-0cd09a48 3s ease-in-out infinite;
}
.nav-label { font-size: 30rpx; font-weight: 700;
}

/* 阿霖IP形象 - 3D立体无背景悬浮 */
.mascot-alin {
  position: fixed;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 100;
  width: 180rpx;
  height: 220rpx;
  cursor: pointer;
  /* 无背景，完全透明 */
  background: transparent;
  /* 3D透视设置 */
  perspective: 2000rpx;
  perspective-origin: center center;
  transform-style: preserve-3d;
  /* 悬浮动画 */
  animation: alinFloat3D-0cd09a48 4s ease-in-out infinite;
  transition: transform 0.3s ease;
  will-change: transform;
}
.mascot-alin:active {
  transform: scale(0.95);
}

/* 3D容器 - 用于3D旋转 */
.alin-3d-container {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  /* 3D旋转动画 - 让阿霖立体旋转 */
  animation: alinRotate3D-0cd09a48 8s linear infinite;
  will-change: transform;
}

/* 阿霖图片 - 无背景，纯立体效果 */
.alin-image {
  width: 100%;
  height: 100%;
  position: relative;
  /* 确保背景透明 */
  background: transparent;
  /* 移除所有背景效果，只保留阴影增强立体感 */
  transform-style: preserve-3d;
  backface-visibility: hidden;
  /* 多层阴影营造3D深度感（无背景，只有阴影） */
  filter: 
    drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.4))
    drop-shadow(0 16rpx 32rpx rgba(0, 0, 0, 0.3))
    drop-shadow(0 24rpx 48rpx rgba(0, 0, 0, 0.25))
    drop-shadow(0 32rpx 64rpx rgba(0, 0, 0, 0.2));
  /* 初始3D变换 - 增强立体感 */
  transform: 
    perspective(2000rpx) 
    translateZ(0);
  transition: transform 0.4s ease;
  will-change: transform;
}
.mascot-alin:hover .alin-3d-container {
  animation-play-state: paused;
}
.mascot-alin:hover .alin-image {
  transform: 
    perspective(2000rpx) 
    translateZ(40rpx)
    scale(1.1);
  filter: 
    drop-shadow(0 12rpx 24rpx rgba(0, 0, 0, 0.5))
    drop-shadow(0 24rpx 48rpx rgba(0, 0, 0, 0.4))
    drop-shadow(0 36rpx 72rpx rgba(0, 0, 0, 0.3))
    drop-shadow(0 48rpx 96rpx rgba(0, 0, 0, 0.25));
}

/* 对话气泡 */
.speech-bubble {
  position: absolute;
  bottom: 100%;
  right: 0;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  color: #333;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(20rpx) scale(0.8);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  pointer-events: none;
  min-width: 200rpx;
  text-align: center;
}
.speech-bubble.show {
  opacity: 1;
  transform: translateY(0) scale(1);
}
.bubble-text {
  display: block;
  line-height: 1.5;
}
.bubble-arrow {
  position: absolute;
  bottom: -16rpx;
  right: 40rpx;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid rgba(255, 255, 255, 0.98);
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.1));
}

/* 阿霖3D立体悬浮动画 - 上下浮动 */
@keyframes alinFloat3D-0cd09a48 {
0%, 100% {
    transform: translateY(0);
}
50% {
    transform: translateY(-20rpx);
}
}

/* 阿霖3D旋转动画 - 360度立体旋转，展现三视图效果 */
@keyframes alinRotate3D-0cd09a48 {
0% {
    transform: 
      perspective(2000rpx) 
      rotateY(0deg) 
      rotateX(5deg)
      translateZ(0);
}
25% {
    transform: 
      perspective(2000rpx) 
      rotateY(90deg) 
      rotateX(5deg)
      translateZ(0);
}
50% {
    transform: 
      perspective(2000rpx) 
      rotateY(180deg) 
      rotateX(5deg)
      translateZ(0);
}
75% {
    transform: 
      perspective(2000rpx) 
      rotateY(270deg) 
      rotateX(5deg)
      translateZ(0);
}
100% {
    transform: 
      perspective(2000rpx) 
      rotateY(360deg) 
      rotateX(5deg)
      translateZ(0);
}
}

/* 粒子上浮 */
.particles { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 0; pointer-events: none;
}
.particle { position: absolute; width: 8rpx; height: 8rpx; background: rgba(255,255,255,0.6); border-radius: 50%; animation: particleFloat-0cd09a48 12s linear infinite;
}
.p1 { left: 10%; animation-delay: 0s; animation-duration: 15s;
}
.p2 { left: 30%; animation-delay: 2s; animation-duration: 18s;
}
.p3 { left: 50%; animation-delay: 4s; animation-duration: 12s;
}
.p4 { left: 70%; animation-delay: 6s; animation-duration: 16s;
}
.p5 { left: 90%; animation-delay: 8s; animation-duration: 14s;
}

/* 动画定义 */
@keyframes titleGlow-0cd09a48 {
0% { text-shadow: 0 0 20rpx rgba(255,215,0,0.6), 0 0 40rpx rgba(255,215,0,0.4), 0 0 60rpx rgba(255,215,0,0.2); transform: scale(1);
}
100% { text-shadow: 0 0 30rpx rgba(255,215,0,0.8), 0 0 60rpx rgba(255,215,0,0.6), 0 0 90rpx rgba(255,215,0,0.4); transform: scale(1.02);
}
}
@keyframes subtitleFloat-0cd09a48 {
0%,100%{ transform: translateY(0); opacity: .8;
}
50%{ transform: translateY(-6rpx); opacity: 1;
}
}
@keyframes emojiFloat-0cd09a48 {
0%,100%{ transform: translateY(0) rotate(0);
}
50%{ transform: translateY(-8rpx) rotate(2deg);
}
}
@keyframes starTwinkle-0cd09a48 {
0%,100%{ opacity:.4; transform: scale(1);
}
50%{ opacity:1; transform: scale(1.2);
}
}
@keyframes glowPulse-0cd09a48 {
0%,100%{ opacity:.3; transform: scale(1);
}
50%{ opacity:.6; transform: scale(1.2);
}
}
@keyframes particleFloat-0cd09a48 {
0%{ transform: translateY(100vh) rotate(0); opacity:0;
}
10%{ opacity:1;
}
90%{ opacity:1;
}
100%{ transform: translateY(-100rpx) rotate(360deg); opacity:0;
}
}

/* 卡片按压动画 */
.card-press {
  transform: scale(0.90) !important;
  opacity: 0.75 !important;
  background: rgba(255, 255, 255, 0.30) !important;
  box-shadow: 0 0 50rpx rgba(255, 215, 0, 0.6), 0 8rpx 20rpx rgba(0, 0, 0, 0.15) !important;
  border-color: rgba(255, 215, 0, 0.5) !important;
  transition: all 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
}

/* 小屏适配 */
@media (max-width: 480px) {
.main-title { font-size: 52rpx;
}
.subtitle { font-size: 26rpx;
}
.nav { grid-row-gap: 20rpx; grid-column-gap: 20rpx;
}
.nav-btn { min-height: 200rpx;
}
.nav-emoji { font-size: 64rpx;
}
.nav-label { font-size: 28rpx;
}
}
