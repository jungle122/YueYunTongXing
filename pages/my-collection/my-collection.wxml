<view class="collection-page">
  <view class="collection-shell">
    <view wx:if="{{favorites.length > 0}}" class="collection-overview">
      <view class="overview-count">
        <text class="count-number">{{favoriteCount}}</text>
        <text class="count-unit">项内容</text>
      </view>
      <view class="overview-copy">
        <text class="overview-title">我的收藏</text>
        <text class="overview-description">{{summaryText}}</text>
      </view>
      <text class="overview-mark" aria-hidden="true">藏</text>
    </view>

    <view class="collection-content">
      <view wx:if="{{favorites.length === 0}}" class="empty-state">
        <view class="empty-symbol">♡</view>
        <text class="empty-title">收藏夹还是空的</text>
        <text class="empty-description">点亮内容旁的爱心即可收藏</text>
      </view>

      <block wx:else>
        <view class="section-heading">
          <view>
            <text class="section-title">收藏内容</text>
          </view>
          <text class="section-count">共 {{favoriteCount}} 项</text>
        </view>

        <view class="collection-list">
          <view wx:for="{{favorites}}" wx:for-item="item" wx:key="id" class="collection-item item-{{item.type}}">
            <view class="item-icon">{{item.icon}}</view>
            <view class="item-info">
              <text class="item-title">{{item.title}}</text>
              <view class="item-meta">
                <text class="type-tag">{{item.typeName}}</text>
                <text class="date-text">{{item.dateStr}}收藏</text>
              </view>
            </view>
            <text class="favorite-mark" aria-label="已收藏">♥</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
