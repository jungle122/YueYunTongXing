<view class="hub-page profile-page {{isPageEntering ? 'page-enter-active' : ''}}">
  <view class="page-intro profile-hero">
    <text class="chapter-seal">第四章</text>
    <text class="intro-title">把每一次进步收藏起来</text>
    <text class="intro-description">看看最近的学习足迹，也记住自己坚持的每一天。</text>
    <text class="hero-ornament">☀</text>
  </view>

  <text class="section-caption">成长档案</text>
  <view wx:if="{{isLoggedIn}}" class="profile-summary">
    <view class="profile-main" bindtap="goToSettings" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="编辑个人资料">
      <view wx:if="{{userAvatarType === 'emoji'}}" class="profile-avatar avatar-emoji">
        <text>{{userAvatar}}</text>
      </view>
      <image wx:elif="{{userAvatar}}" src="{{userAvatar}}" class="profile-avatar" mode="aspectFill" binderror="onAvatarError" />
      <view wx:else class="profile-avatar avatar-text">我</view>
      <view class="profile-copy">
        <text class="profile-name">{{userNickname || "用户"}}</text>
        <text class="profile-caption">今天也和粤语童谣见面吧</text>
      </view>
      <text class="feature-arrow">›</text>
    </view>
    <view class="stats-grid">
      <view class="stat-cell"><text class="stat-number">{{stats.learningDays}}</text><text class="stat-label">学习天数</text></view>
      <view class="stat-cell"><text class="stat-number">{{stats.favoriteCount}}</text><text class="stat-label">收藏内容</text></view>
      <view class="stat-cell"><text class="stat-number">{{stats.currentStreak}}</text><text class="stat-label">连续学习</text></view>
    </view>
  </view>

  <view wx:else class="login-panel" bindtap="goToLogin" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="去登录">
    <view class="login-symbol">🏡</view>
    <view class="login-copy">
      <text class="login-title">欢迎来到粤语童谣时光屋</text>
      <text class="login-subtitle">设置昵称和头像，开始记录成长。</text>
    </view>
    <text class="login-action">去登录</text>
  </view>

  <view class="menu-section">
    <text class="section-caption menu-heading">学习记录</text>
    <view class="menu-list">
      <view class="menu-row enter-menu-1" bindtap="goToMyCollection" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="查看我的收藏">
        <view class="menu-symbol collection-symbol">⭐</view>
        <view class="menu-copy"><text class="menu-title">我的收藏</text><text class="menu-description">童谣、视频、绘本和文章</text></view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="menu-row enter-menu-2" bindtap="goToHistory" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="查看历史记录">
        <view class="menu-symbol history-symbol">🕰</view>
        <view class="menu-copy"><text class="menu-title">历史记录</text><text class="menu-description">最近学习过的内容</text></view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="menu-row enter-menu-3" bindtap="goToLearningStats" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="查看学习统计">
        <view class="menu-symbol stats-symbol">📈</view>
        <view class="menu-copy"><text class="menu-title">学习统计</text><text class="menu-description">查看天数和学习趋势</text></view>
        <text class="feature-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <text class="section-caption menu-heading">互动与反馈</text>
    <view class="menu-list">
      <view class="menu-row enter-menu-4" bindtap="goToCommunity" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="进入互动社区">
        <view class="menu-symbol community-symbol">🤝</view>
        <view class="menu-copy"><text class="menu-title">互动社区</text><text class="menu-description">打卡排行 · 成就徽章</text></view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="menu-row enter-menu-5" bindtap="goToFeedback" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="提交建议反馈">
        <view class="menu-symbol feedback-symbol">💌</view>
        <view class="menu-copy"><text class="menu-title">建议反馈</text><text class="menu-description">帮助我们做得更好</text></view>
        <text class="feature-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section preference-section">
    <text class="section-caption menu-heading">偏好设置</text>
    <view class="menu-list">
      <view class="menu-row enter-menu-6" bindtap="goToSettings" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="打开个性化设置">
        <view class="menu-symbol settings-symbol">⚙</view>
        <view class="menu-copy"><text class="menu-title">个性化设置</text><text class="menu-description">头像、昵称和学习偏好</text></view>
        <text class="feature-arrow">›</text>
      </view>
    </view>
  </view>
</view>
