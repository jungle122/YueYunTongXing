.profile-hero {
  border-color: #bcd8e9;
  background: linear-gradient(145deg, #edf7fd 0%, #e2f2fb 100%);
}

.profile-hero .chapter-seal { color: #487799; }

.profile-summary,
.login-panel,
.menu-list {
  border: 2rpx solid #ead5b5;
  border-radius: 28rpx;
  background: #fffdf5;
  box-shadow: 0 10rpx 24rpx rgba(104, 66, 43, 0.08);
}

.profile-summary {
  padding: 26rpx;
  overflow: hidden;
}

.profile-main,
.login-panel,
.menu-row {
  display: flex;
  align-items: center;
}

.profile-main {
  min-height: 104rpx;
  transition: transform 180ms ease-out, opacity 180ms ease-out;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  margin-right: 22rpx;
  border: 5rpx solid #f1c96e;
  border-radius: 50%;
  background: #d66d52;
  box-sizing: border-box;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdf5;
  font-size: 32rpx;
  font-weight: 800;
}

.profile-copy,
.login-copy,
.menu-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.profile-name,
.login-title {
  color: #49352d;
  font-size: 29rpx;
  font-weight: 800;
}

.profile-caption,
.login-subtitle,
.menu-description {
  margin-top: 7rpx;
  color: #7a655a;
  font-size: 21rpx;
  line-height: 1.45;
}

.stats-grid {
  margin-top: 26rpx;
  padding-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 2rpx dashed #e6d1b2;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-cell + .stat-cell { border-left: 2rpx solid #eadbc4; }

.stat-number {
  color: #b4513d;
  font-size: 35rpx;
  font-weight: 850;
}

.stat-label {
  margin-top: 6rpx;
  color: #806b60;
  font-size: 20rpx;
}

.login-panel {
  min-height: 150rpx;
  padding: 24rpx;
  box-sizing: border-box;
  transition: transform 180ms ease-out, opacity 180ms ease-out;
}

.login-symbol,
.menu-symbol {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  
  
}

.login-symbol {
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  border-radius: 25rpx;
  background: #ffe8c2;
  font-size: 40rpx;
}

.login-action {
  margin-left: 14rpx;
  flex: 0 0 auto;
  color: #a94736;
  font-size: 21rpx;
  font-weight: 750;
}

.menu-section { margin-top: 32rpx; }
.preference-section { margin-top: 28rpx; }

.menu-heading {
  margin-top: 0;
  margin-bottom: 16rpx;
}

.menu-list { overflow: hidden; }

.menu-row {
  min-height: 120rpx;
  margin: 0 24rpx;
  box-sizing: border-box;
  transition: transform 180ms ease-out, opacity 180ms ease-out;
}

.menu-row + .menu-row { border-top: 2rpx dashed #eadbc4; }

.menu-symbol {
  width: 68rpx;
  height: 68rpx;
  overflow: hidden;
  border-radius: 20rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  font-size: 31rpx;
}






.menu-symbol image { width: 100%; height: 100%; }
.menu-title {
  color: #49352d;
  font-size: 27rpx;
  font-weight: 750;
}

@media (max-width: 340px) {
  .login-title { font-size: 26rpx; }
  .login-symbol { width: 74rpx; height: 74rpx; }
  .menu-row { margin-left: 20rpx; margin-right: 20rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .profile-main,
  .login-panel,
  .menu-row { transition: none; }
}

/* 初版成长页分层入场动画，使用显式 class 以便 TabBar 页面再次显示时重播。 */
.profile-page.page-enter-active {
  animation: pageEnter-profile 500ms ease-out;
}

.profile-page.page-enter-active .profile-hero {
  animation: headerFadeIn-profile 400ms ease-out 100ms both;
}

.profile-page.page-enter-active > .section-caption,
.profile-page.page-enter-active .menu-heading {
  animation: contentFadeUp-profile 500ms ease-out 150ms both;
}

.profile-page.page-enter-active .profile-summary,
.profile-page.page-enter-active .login-panel {
  animation: sectionPopIn-profile 500ms cubic-bezier(0.34, 1.56, 0.64, 1) 200ms both;
}

.profile-page.page-enter-active .enter-menu-1 {
  animation: menuSlideIn-profile 500ms ease-out 280ms both;
}

.profile-page.page-enter-active .enter-menu-2 {
  animation: menuSlideIn-profile 500ms ease-out 380ms both;
}

.profile-page.page-enter-active .enter-menu-3 {
  animation: menuSlideIn-profile 500ms ease-out 480ms both;
}

.profile-page.page-enter-active .enter-menu-4 {
  animation: menuSlideIn-profile 500ms ease-out 580ms both;
}

@keyframes pageEnter-profile {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes headerFadeIn-profile {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes contentFadeUp-profile {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes sectionPopIn-profile {
  0% { opacity: 0; transform: scale(0.9) translateY(20rpx); }
  70% { transform: scale(1.02) translateY(-4rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes menuSlideIn-profile {
  0% { opacity: 0; transform: translateX(60rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

@media (prefers-reduced-motion: reduce) {
  .profile-page.page-enter-active,
  .profile-page.page-enter-active .profile-hero,
  .profile-page.page-enter-active > .section-caption,
  .profile-page.page-enter-active .menu-heading,
  .profile-page.page-enter-active .profile-summary,
  .profile-page.page-enter-active .login-panel,
  .profile-page.page-enter-active .menu-row {
    animation: none;
  }
}

/* Emoji头像样式 */
.avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  background: linear-gradient(135deg, #ffe8c2, #ffd7a8);
}

