<view class="community-page">
  <view class="page-intro community-hero">
    <text class="chapter-seal">第五章</text>
    <text class="intro-title">和小伙伴们一起成长</text>
    <text class="intro-description">本机打卡、成就徽章、云端成长分享。</text>
    <text class="hero-ornament">🌟</text>
  </view>

  <text class="section-caption">🔥 每日打卡墙 · 本机记录</text>
  <view class="checkin-card">
    <view class="checkin-header">
      <view class="checkin-info">
        <text class="checkin-days">{{checkinStreak}}</text>
        <text class="checkin-label">连续打卡天数</text>
      </view>
      <view class="checkin-btn-wrap">
        <view
          class="checkin-btn {{todayCheckedIn ? 'checkin-done' : ''}}"
          bindtap="handleCheckin"
          hover-class="checkin-btn-press"
        >
          <text>{{todayCheckedIn ? '✓ 已打卡' : '立即打卡'}}</text>
        </view>
      </view>
    </view>
    <view class="checkin-calendar">
      <view wx:for="{{calendarDays}}" wx:key="date" class="calendar-item {{item.checked ? 'calendar-checked' : ''}} {{item.today ? 'calendar-today' : ''}}">
        <text class="calendar-day">{{item.day}}</text>
        <text class="calendar-dot" wx:if="{{item.checked}}">✓</text>
      </view>
    </view>
    <view class="checkin-total">
      <text class="total-text">累计打卡 {{totalCheckins}} 天</text>
    </view>
  </view>

  <text class="section-caption">🎖 我的成就墙 · 本机记录</text>
  <view class="achievements-card">
    <view wx:for="{{achievements}}" wx:key="id" class="achievement-item {{item.unlocked ? 'achievement-unlocked' : 'achievement-locked'}}">
      <view class="achievement-icon">
        <text>{{item.icon}}</text>
      </view>
      <view class="achievement-info">
        <text class="achievement-name">{{item.name}}</text>
        <text class="achievement-desc">{{item.desc}}</text>
      </view>
      <view wx:if="{{item.unlocked}}" class="achievement-status">✓</view>
      <view wx:else class="achievement-status locked">🔒</view>
    </view>
  </view>

  <text class="section-caption">💬 云端成长分享墙</text>
  <view class="messageboard-card">
    <view class="share-intro">
      <view>
        <text class="share-title">选择一句话，分享今天的学习心情</text>
        <text class="share-subtitle">正文由固定模板生成，大家都能看到</text>
      </view>
      <text class="study-pill">{{todayStudyText}}</text>
    </view>

    <view class="share-form">
      <view class="form-field">
        <text class="form-label">分享类型</text>
        <picker
          mode="selector"
          range="{{templateGroupLabels}}"
          value="{{selectedGroupIndex}}"
          bindchange="onTemplateGroupChange"
        >
          <view class="picker-control {{selectedGroupLabel ? '' : 'picker-placeholder'}}">
            <text>{{selectedGroupLabel || '请选择分享类型'}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
      </view>

      <view class="form-field">
        <text class="form-label">想说的话</text>
        <picker
          mode="selector"
          range="{{currentTemplateOptions}}"
          range-key="displayText"
          value="{{selectedTemplateIndex}}"
          disabled="{{selectedGroupIndex === -1}}"
          bindchange="onTemplateChange"
        >
          <view class="picker-control {{selectedGroupIndex === -1 ? 'picker-disabled' : ''}} {{selectedTemplateLabel ? '' : 'picker-placeholder'}}">
            <text>{{selectedTemplateLabel || (selectedGroupIndex === -1 ? '请先选择分享类型' : '请选择一句话')}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
      </view>
    </view>

    <view wx:if="{{selectedTemplateText}}" class="share-preview">
      <text class="preview-label">发布预览</text>
      <text class="preview-text">{{selectedTemplateText}}</text>
      <text class="preview-note">带时长的内容来自这台手机的今日学习记录</text>
    </view>
    <view
      class="publish-btn {{!selectedTemplateId || isPublishing ? 'publish-disabled' : ''}}"
      bindtap="publishPost"
      hover-class="publish-btn-press"
    >
      <text>{{isPublishing ? '正在发布...' : '发布到成长墙'}}</text>
    </view>
  </view>

  <view class="community-feed">
    <view class="feed-heading">
      <text class="feed-title">小伙伴们的分享</text>
      <text class="feed-refresh" bindtap="retryLoadPosts">刷新</text>
    </view>

    <view wx:if="{{postsLoading && posts.length === 0}}" class="empty-hint">
      <text>正在加载成长分享...</text>
    </view>
    <view wx:elif="{{postsError && posts.length === 0}}" class="empty-hint error-hint" bindtap="retryLoadPosts">
      <text>{{postsError}}</text>
      <text class="retry-text">点击重试</text>
    </view>
    <view wx:elif="{{posts.length === 0}}" class="empty-hint">
      <text>还没有成长分享，来发布第一句话吧～</text>
    </view>

    <view class="messages-list">
      <view wx:for="{{posts}}" wx:key="id" class="message-item">
        <view class="msg-avatar">
          <text wx:if="{{item.avatarType === 'emoji'}}">{{item.avatar || '👤'}}</text>
          <image wx:else src="{{item.avatar}}" class="msg-avatar-img" mode="aspectFill" />
        </view>
        <view class="msg-content">
          <view class="msg-header">
            <text class="msg-name">{{item.nickname}}</text>
            <text class="msg-time">{{item.timeText}}</text>
            <text wx:if="{{item.isMine}}" class="mine-badge">我的</text>
          </view>
          <text class="msg-text">{{item.content}}</text>
          <view class="msg-footer">
            <text wx:if="{{item.usesStudyTime}}" class="source-note">本机学习记录</text>
            <text wx:if="{{item.isMine}}" class="delete-post" bindtap="requestDeletePost" data-id="{{item.id}}">删除</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{postsLoadingMore}}" class="load-more">正在加载...</view>
    <view wx:elif="{{hasMorePosts}}" class="load-more load-more-action" bindtap="loadMorePosts">查看更多分享</view>
    <view wx:elif="{{posts.length > 0}}" class="load-more">已经看到全部分享啦</view>
  </view>
</view>
