.community-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 94% 4%, rgba(244, 190, 80, 0.088), transparent 26%),
    radial-gradient(circle at 2% 42%, rgba(224, 126, 98, 0.04), transparent 20%),
    var(--color-bg);
}

.community-hero {
  border-color: #e8c8a0;
  background: linear-gradient(145deg, #fff5e6 0%, #ffe8d0 100%);
}

.community-hero .chapter-seal { color: var(--color-primary); }

/* 打卡卡片 */
.checkin-card {
  padding: 26rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}

.checkin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.checkin-info {
  display: flex;
  flex-direction: column;
}

.checkin-days {
  font-size: 48rpx;
  font-weight: 850;
  color: var(--color-primary);
}

.checkin-label {
  font-size: 21rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.checkin-btn-wrap {
  display: flex;
  align-items: center;
}

.checkin-btn {
  padding: 18rpx 36rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: none;
}

.checkin-btn-press {
  opacity: 0.85;
  transform: scale(0.96);
}

.checkin-done {
  background: var(--color-success-soft);
  box-shadow: none;
 color: var(--color-success); }

.checkin-calendar {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  padding: 16rpx 0;
  border-top: 2rpx dashed var(--color-border);
  border-bottom: 2rpx dashed var(--color-border);
}

.calendar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--color-surface-soft);
  border: 2rpx solid transparent;
}

.calendar-checked {
  background: var(--color-warning-soft);
  border-color: var(--color-primary);
}

.calendar-today {
  box-shadow: none;
}

.calendar-day {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text);
}

.calendar-dot {
  font-size: 18rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.checkin-total {
  margin-top: 16rpx;
  text-align: center;
}

.total-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 成就墙 */
.achievements-card {
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}

.achievement-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
}

.achievement-item:last-child {
  border-bottom: none;
}

.achievement-unlocked {
  opacity: 1;
}

.achievement-locked {
  opacity: 0.5;
}

.achievement-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffe8c2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 18rpx;
}

.achievement-unlocked .achievement-icon {
  background: linear-gradient(135deg, #ffd700, #ffb347);
  box-shadow: none;
}

.achievement-info {
  flex: 1;
}

.achievement-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

.achievement-desc {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.achievement-status {
  font-size: 28rpx;
  color: #7db487;
  font-weight: 700;
}

.achievement-status.locked {
  font-size: 24rpx;
  opacity: 0.6;
}

/* 云端成长分享 */
.messageboard-card {
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}

.share-intro {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.share-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text);
}

.share-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 19rpx;
  color: var(--color-text-muted);
}

.study-pill {
  flex-shrink: 0;
  padding: 9rpx 14rpx;
  border-radius: 18rpx;
  background: #fff0cf;
  color: #a25d39;
  font-size: 19rpx;
  font-weight: 700;
}

.share-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  color: var(--color-text-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.picker-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 46rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #e0c7a7;
  border-radius: 18rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 22rpx;
  line-height: 1.45;
}

.picker-placeholder {
  color: var(--color-text-muted);
}

.picker-disabled {
  background: var(--color-surface-soft);
  opacity: 0.65;
}

.picker-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.share-preview {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f1f8ed;
  border: 2rpx solid #c8dfc2;
}

.preview-label {
  display: block;
  font-size: 19rpx;
  font-weight: 700;
  color: #66805f;
}

.preview-text {
  display: block;
  margin-top: 8rpx;
  color: #3f553b;
  font-size: 24rpx;
  line-height: 1.6;
}

.preview-note {
  display: block;
  margin-top: 10rpx;
  color: #809279;
  font-size: 18rpx;
}

.publish-btn {
  margin-top: 22rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: var(--color-white);
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: none;
}

.publish-btn-press {
  transform: scale(0.98);
}

.publish-disabled {
  opacity: 0.48;
}

.community-feed {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}

.feed-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 2rpx dashed var(--color-border);
}

.feed-title {
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 700;
}

.feed-refresh {
  padding: 6rpx 12rpx;
  color: var(--color-primary);
  font-size: 20rpx;
}

.messages-list {
  width: 100%;
}

.message-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
}

.message-item:last-child {
  border-bottom: none;
}

.msg-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ffe8c2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 14rpx;
  border: 2rpx solid #f1c96e;
  overflow: hidden;
  flex-shrink: 0;
}

.msg-avatar-img {
  width: 100%;
  height: 100%;
}

.msg-content {
  flex: 1;
}

.msg-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.msg-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text);
}

.msg-time {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.msg-text {
  display: block;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.mine-badge {
  padding: 2rpx 9rpx;
  border-radius: var(--radius-label);
  background: #fff0cf;
  color: #a25d39;
  font-size: 17rpx;
}

.msg-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 30rpx;
  margin-top: 10rpx;
}

.source-note {
  color: var(--color-text-muted);
  font-size: 17rpx;
}

.delete-post {
  margin-left: auto;
  padding: 4rpx 0 4rpx 18rpx;
  color: var(--color-primary);
  font-size: 19rpx;
}

.error-hint {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.retry-text,
.load-more-action {
  color: var(--color-primary);
  font-weight: 700;
}

.load-more {
  padding: 22rpx 0 8rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 20rpx;
}

/* 通用样式 */
.empty-hint {
  text-align: center;
  padding: 40rpx 20rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

@media (max-width: 340px) {
  .community-page { padding-left: 22rpx; padding-right: 22rpx; }
  .calendar-item { width: 62rpx; }
}

.checkin-btn:active, .publish-btn:active { background: var(--color-primary-pressed); }
.checkin-done:active { background: var(--color-success-soft); }
.publish-disabled { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }
