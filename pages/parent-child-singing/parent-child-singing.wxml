<view class="parent-singing-page">
  <view class="bg-stars"></view>
  <view class="container">
    <view class="header">
      <view class="back-btn" bindtap="goBack">←</view>
      <text class="page-title">亲子传唱</text>
      <view></view>
    </view>
    <view class="content">
      <view wx:for="{{displaySongs}}" wx:for-item="song" wx:key="id" class="singing-card">
        <view class="singing-header">
          <view class="singing-icon">{{song.icon}}</view>
          <view class="singing-info">
            <text class="singing-title">{{song.title}}</text>
            <text class="singing-description">{{song.description}}</text>
          </view>
        </view>
        <view class="singing-actions">
          <button class="action-btn {{song.isPlaying ? 'playing' : ''}}" bindtap="playSong" data-song="{{song}}">{{song.playBtnText}}</button>
          <button class="action-btn {{song.isRecording ? 'recording' : ''}}" bindtap="toggleRecording" data-song="{{song}}">{{song.recordBtnText}}</button>
          <button class="action-btn {{song.isReplaying ? 'playing' : ''}}" bindtap="playRecording" data-song="{{song}}">{{song.replayBtnText}}</button>
        </view>
        <view class="lyrics-area">
          <view class="lyrics-title">📝 歌词</view>
          <view class="lyrics-content">
            <text wx:for="{{song.lyrics}}" wx:for-item="line" wx:key="*this" class="lyric-line">{{line}}</text>
          </view>
        </view>
        <view class="singing-tips">
          <view class="tips-title">💡 传唱小贴士</view>
          <view class="tips-list">
            <text wx:for="{{song.tips}}" wx:for-item="tip" wx:key="*this" class="tip-item">{{tip}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{showRecordingModal}}" class="modal-mask" bindtap="stopRecording">
    <view class="modal-content recording-modal" catchtap="">
      <view class="modal-title">🎙️ 录音中</view>
      <view class="modal-text">正在录音，请开始演唱...</view>
      <button class="modal-btn" bindtap="stopRecording">停止录音</button>
    </view>
  </view>
  <view wx:if="{{showRecordingComplete}}" class="toast-success">
    <text>✅ 录音完成</text>
  </view>
</view>
