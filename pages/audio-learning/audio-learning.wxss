.audio-library-page {
  min-height: 100vh;
  color: #49372f;
  background:
    radial-gradient(circle at 92% 4%, rgba(235, 156, 91, 0.18), transparent 24%),
    #fff8eb;
}

.library-shell {
  min-height: 100vh;
  padding: 24rpx 28rpx 70rpx;
  box-sizing: border-box;
}

.media-notice {
  display: block;
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  color: #806d61;
  font-size: 22rpx;
  text-align: center;
  background: rgba(255, 254, 249, 0.92);
}
.media-error { color: #b45f4a; }
.media-retry {
  margin-left: 16rpx;
  color: #c85f48;
  font-weight: 700;
}

.song-list {
  overflow: hidden;
  border: 2rpx solid #ead9be;
  border-radius: 28rpx;
  background: rgba(255, 254, 249, 0.96);
  box-shadow: 0 12rpx 28rpx rgba(93, 61, 42, 0.08);
}

.song-row {
  position: relative;
  min-height: 142rpx;
  padding: 20rpx 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  transition: opacity 150ms ease-out, background-color 150ms ease-out;
}
.song-row + .song-row::before {
  content: "";
  position: absolute;
  left: 132rpx;
  right: 20rpx;
  top: 0;
  height: 2rpx;
  background: #f0e4d2;
}
.song-row-press { opacity: 0.72; background: #fff7e7; }

.cover-box {
  position: relative;
  width: 94rpx;
  height: 94rpx;
  margin-right: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  border-radius: 18rpx;
}
.cover-image { width: 100%; height: 100%; }
.cover-placeholder { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.cover-note { color: rgba(74, 52, 42, 0.48); font-size: 48rpx; font-weight: 900; transform: rotate(-8deg); }
.cover-order { position: absolute; right: 7rpx; bottom: 5rpx; color: rgba(74, 52, 42, 0.58); font-size: 16rpx; font-weight: 900; }

.song-copy { flex: 1; min-width: 0; }
.title-row { display: flex; align-items: center; }
.song-title { overflow: hidden; color: #49372f; font-size: 28rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.liked-mark { margin-left: 10rpx; color: #d4665e; font-size: 21rpx; }
.song-meta { display: block; margin-top: 8rpx; color: #9a8273; font-size: 20rpx; }
.progress-track { width: 176rpx; height: 7rpx; margin-top: 12rpx; overflow: hidden; border-radius: 7rpx; background: #efe3d1; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #e99a52, #d36650); }
.row-arrow { margin-left: 16rpx; color: #b48067; font-size: 43rpx; }

.theme-stars { background: linear-gradient(145deg, #f8e38e, #e7b85f); }
.theme-piglets { background: linear-gradient(145deg, #f7d3ca, #e9a18f); }
.theme-girl { background: linear-gradient(145deg, #f5d5a7, #eab06c); }
.theme-duck { background: linear-gradient(145deg, #cce8df, #86c6b3); }
.theme-garden { background: linear-gradient(145deg, #d8eab7, #9ec77d); }
.theme-river { background: linear-gradient(145deg, #d7e6c7, #9fc291); }
.theme-moon { background: linear-gradient(145deg, #d4d1e4, #9f99c5); }
.theme-rain { background: linear-gradient(145deg, #cee2e9, #92bbc9); }
.theme-circle { background: linear-gradient(145deg, #f2d59f, #e2a75e); }
.theme-rooster { background: linear-gradient(145deg, #f1c6a2, #df915e); }
.theme-bath { background: linear-gradient(145deg, #cee7e6, #8bc9c7); }

@media (max-width: 340px) {
  .library-shell { padding-left: 22rpx; padding-right: 22rpx; }
  .cover-box { width: 84rpx; height: 84rpx; margin-right: 16rpx; }
  .song-row + .song-row::before { left: 120rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .song-row { transition: none; }
}
