<view class="audio-library-page">
  <view class="library-shell">
    <view class="song-list">
      <view
        wx:for="{{songs}}"
        wx:for-item="song"
        wx:key="id"
        class="song-row"
        bindtap="openSong"
        data-id="{{song.id}}"
        hover-class="song-row-press"
        hover-stay-time="120"
        aria-role="button"
        aria-label="播放{{song.title}}"
      >
        <view class="cover-box {{song.themeClass}}">
          <image wx:if="{{song.backgroundImage}}" class="cover-image" src="{{song.backgroundImage}}" mode="aspectFill" aria-label="{{song.title}}封面"></image>
          <view wx:else class="cover-placeholder" aria-label="歌曲封面图占位">
            <text class="cover-note">♪</text>
            <text class="cover-order">{{song.orderText}}</text>
          </view>
        </view>

        <view class="song-copy">
          <view class="title-row">
            <text class="song-title">{{song.title}}</text>
            <text wx:if="{{song.isLiked}}" class="liked-mark" aria-label="已收藏">♥</text>
          </view>
          <text class="song-meta">{{song.lesson}} · {{song.progressText}}</text>
          <view class="progress-track">
            <view class="progress-fill" style="width: {{song.progress}}%;"></view>
          </view>
        </view>

        <text class="row-arrow" aria-hidden="true">›</text>
      </view>
    </view>
  </view>
</view>
