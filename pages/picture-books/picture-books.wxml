<view class="picture-books-page">
  <view class="container">
    <view class="header">
      <view class="back-btn" bindtap="goBack">←</view>
      <text class="page-title">绘本欣赏</text>
      <view></view>
    </view>
    <view class="book-selector">
      <text class="selector-title">绘本书架</text>
      <text class="book-count">共 {{displayBooks.length}} 本</text>
      <view class="bookshelf">
        <view wx:for="{{displayBooks}}" wx:for-item="book" wx:key="id" class="book-card {{book.isActive ? 'active' : ''}}" bindtap="selectBook" data-bookid="{{book.id}}">
          <image src="{{book.cover}}" mode="aspectFill" class="book-cover" lazy-load="{{true}}"/>
          <text class="book-card-title">{{book.title}}</text>
          <text class="book-card-pages">{{book.pages}} 页 · 粤语绘本</text>
        </view>
      </view>
    </view>
    <view class="book-viewer">
      <text class="book-title">{{currentTitle}}</text>
      <text class="book-page-info">第 {{currentPageIndex + 1}} 页 / 共 {{totalPages}} 页</text>
      <image key="{{imageKey}}-{{currentPageIndex}}" src="{{currentPagePath}}" mode="widthFix" class="book-image" lazy-load="{{false}}" show-menu-by-longpress="{{false}}" binderror="onImageError" bindload="onImageLoad"/>
      <view class="page-controls">
        <button class="page-btn" disabled="{{isFirstPage}}" bindtap="previousPage">← 上一页</button>
        <button class="page-btn" disabled="{{isLastPage}}" bindtap="nextPage">下一页 →</button>
      </view>
    </view>
  </view>
</view>