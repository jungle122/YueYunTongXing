.picture-books-page {
  min-height: 100vh;
  background: #fff7e8;
  position: relative;
  overflow: hidden;
}
.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 28rpx 60rpx 28rpx;
  box-sizing: border-box;
}
.book-selector {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(73, 53, 45, 0.06);
}
.selector-title {
  display: block;
  color: #49352d;
  font-size: 32rpx;
  margin-bottom: 8rpx;
  font-weight: 700;
}
.book-count {
  display: block;
  color: #998;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  text-align: right;
}
.bookshelf {
  display: flex;
  width: 100%;
  height: 420rpx;
  white-space: nowrap;
}
.book-card {
  flex: 0 0 200rpx;
  width: 200rpx;
  height: 404rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  text-align: center;
  padding: 12rpx;
  margin-right: 20rpx;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.3s;
}
.book-card:last-child {
  margin-right: 0;
}
.book-card.active {
  border-color: #cf684b;
  background: rgba(207, 104, 75, 0.06);
  box-shadow: 0 0 24rpx rgba(207, 104, 75, 0.15);
}
.book-cover {
  width: 100%;
  height: 280rpx;
  flex-shrink: 0;
  background: #fffaf2;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}
.book-card-title {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #49352d;
  font-size: 26rpx;
  font-weight: 700;
  margin-top: 12rpx;
  margin-bottom: 4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-card-pages {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #998;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-viewer {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx;
  text-align: center;
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(73, 53, 45, 0.06);
}
.book-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #49352d;
  margin-bottom: 16rpx;
}
.book-page-info {
  font-size: 26rpx;
  color: #998;
  margin-bottom: 30rpx;
}
.book-image {
  max-width: 100%;
  max-height: 600rpx;
  border-radius: 12rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}
.page-controls {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 30rpx;
}
.page-btn {
  background: #cf684b;
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  min-width: 200rpx;
  transition: all 0.3s;
}
.page-btn:disabled {
  background: #ddd;
  color: #999;
  opacity: 0.6;
}
.media-state-card {
  min-height: 420rpx;
  padding: 60rpx 40rpx;
  border-radius: 28rpx;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(73, 53, 45, 0.06);
}
.media-state-title {
  color: #49352d;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.media-state-message {
  color: #887a73;
  font-size: 26rpx;
  line-height: 1.6;
}
.retry-btn {
  margin-top: 32rpx;
  min-width: 220rpx;
  border: none;
  border-radius: 20rpx;
  background: #cf684b;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
