.picture-books-page {
  min-height: 100vh;
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}
.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 28rpx 60rpx 28rpx;
  box-sizing: border-box;
}
.book-selector {
  background: var(--color-white);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: none;
}
.selector-heading {
  margin-bottom: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.selector-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}
.book-count {
  color: var(--color-text-muted);
  font-size: 24rpx;
}
.bookshelf {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}
.book-card {
  min-width: 0;
  min-height: 238rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 10rpx 5rpx 12rpx;
  border-radius: var(--radius-card);
  border: 3rpx solid var(--color-surface-soft);
  background: var(--color-surface);
  transition: border-color 0.3s, background-color 0.3s, box-shadow 0.3s, transform 0.3s;
}
.book-card.active {
  border-color: var(--color-primary);
  background: rgba(207, 104, 75, 0.06);
  box-shadow: none;
  transform: translateY(-3rpx);
}
.book-cover {
  width: 112rpx;
  height: 158rpx;
  flex-shrink: 0;
  background: var(--color-surface);
  border-radius: 9rpx;
  box-shadow: none;
}
.book-card-title {
  display: block;
  width: 100%;
  overflow: hidden;
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 700;
  margin-top: 8rpx;
  margin-bottom: 2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-card-pages {
  display: block;
  width: 100%;
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
@media (max-width: 340px) {
  .container { padding-left: 20rpx; padding-right: 20rpx; }
  .book-selector { padding-left: 16rpx; padding-right: 16rpx; }
  .bookshelf { gap: 6rpx; }
  .book-card { min-height: 222rpx; padding-left: 3rpx; padding-right: 3rpx; }
  .book-cover { width: 100rpx; height: 140rpx; }
  .book-card-title { font-size: 18rpx; }
}
.book-viewer {
  background: var(--color-white);
  border-radius: var(--radius-card);
  padding: 40rpx;
  text-align: center;
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: none;
}
.book-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
}
.book-page-info {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-bottom: 30rpx;
}
.book-image {
  max-width: 100%;
  max-height: 600rpx;
  border-radius: 12rpx;
  box-shadow: none;
  margin-bottom: 30rpx;
}
.book-subtitle {
  display: block;
  max-width: 100%;
  margin-bottom: 30rpx;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  background: rgba(207, 104, 75, 0.08);
  color: var(--color-text-secondary);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.6;
}
.page-controls {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 30rpx;
}
.page-btn {
  background: var(--color-primary);
  border: none;
  border-radius: var(--radius-control);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-white);
  min-width: 200rpx;
  transition: all 0.3s;
}
.page-btn:disabled {
  background: var(--color-disabled-bg);
  color: var(--color-text-muted);
  opacity: 0.6;
}
.media-state-card {
  min-height: 420rpx;
  padding: 60rpx 40rpx;
  border-radius: var(--radius-card);
  background: var(--color-white);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: none;
}
.media-state-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.media-state-message {
  color: var(--color-text-muted);
  font-size: 26rpx;
  line-height: 1.6;
}
.retry-btn {
  margin-top: 32rpx;
  min-width: 220rpx;
  border: none;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 28rpx;
  font-weight: 700;
}

/* 主操作统一使用品牌陶土红；按下和禁用状态与章节色分离。 */
.page-btn:active,
.retry-btn:active { background: var(--color-primary-pressed); }
.page-btn[disabled],
.retry-btn[disabled] { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }
