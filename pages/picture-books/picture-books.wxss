.picture-books-page {
  min-height: 100vh;
  color: #49372f;
  background:
    radial-gradient(circle at 96% 4%, rgba(242, 177, 91, 0.18), transparent 24%),
    radial-gradient(circle at 2% 42%, rgba(226, 126, 102, 0.1), transparent 20%),
    #fff7e8;
}

.book-shell {
  min-height: 100vh;
  padding: 24rpx 28rpx 76rpx;
  box-sizing: border-box;
  animation: pageEnter 380ms ease-out both;
}

.shelf-heading {
  margin: 0 6rpx 18rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  display: block;
  color: #553f35;
  font-size: 29rpx;
  font-weight: 900;
}

.section-description {
  display: block;
  margin-top: 5rpx;
  color: #94796b;
  font-size: 19rpx;
}

.book-total {
  color: #a27f6d;
  font-size: 18rpx;
}

.book-shelf {
  width: calc(100% + 56rpx);
  margin-left: -28rpx;
  padding-bottom: 10rpx;
  white-space: nowrap;
}

.shelf-track {
  padding: 0 28rpx;
  display: inline-flex;
  gap: 18rpx;
}

.shelf-book {
  width: 224rpx;
  padding: 12rpx 12rpx 16rpx;
  border: 3rpx solid transparent;
  border-radius: 26rpx;
  background: #fffdf6;
  box-shadow: 0 9rpx 22rpx rgba(92, 61, 43, 0.09);
  box-sizing: border-box;
  transition: transform 160ms ease-out, border-color 160ms ease-out, box-shadow 160ms ease-out;
}

.shelf-book-active {
  border-color: #c97963;
  box-shadow: 0 11rpx 26rpx rgba(162, 85, 66, 0.17);
}

.book-press { opacity: 0.88; transform: scale(0.97); }

.cover-frame {
  position: relative;
  width: 100%;
  height: 226rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ead9c1;
}

.cover-image { width: 100%; height: 100%; }

.cover-frame::after {
  content: "";
  position: absolute;
  inset: 0;
  border: 2rpx solid rgba(73, 53, 45, 0.08);
  border-radius: 18rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.cover-order {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 4rpx 8rpx;
  border-radius: 9rpx;
  background: rgba(63, 44, 36, 0.58);
  color: #fffaf1;
  font-size: 15rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.reading-badge {
  position: absolute;
  right: 9rpx;
  bottom: 9rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #a6555e;
  color: #fff;
  font-size: 15rpx;
  font-weight: 850;
}

.cover-favorite {
  position: absolute;
  right: 10rpx;
  top: 9rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 250, 241, 0.9);
  color: #bd5f70;
  font-size: 23rpx;
  line-height: 40rpx;
  text-align: center;
  box-shadow: 0 3rpx 8rpx rgba(76, 45, 36, 0.13);
}

.shelf-book-title {
  display: block;
  margin-top: 13rpx;
  overflow: hidden;
  color: #4d3930;
  font-size: 22rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shelf-book-meta {
  display: block;
  margin-top: 4rpx;
  color: #9a7e70;
  font-size: 16rpx;
}

.book-coral .cover-frame { background: #efb2aa; }
.book-sage .cover-frame { background: #b7d0ad; }
.book-moon .cover-frame { background: #b6c9d9; }

.reader-card {
  margin-top: 28rpx;
  padding: 24rpx;
  border: 2rpx solid #ead5b5;
  border-radius: 32rpx;
  background: #fffdf6;
  box-shadow: 0 14rpx 32rpx rgba(93, 61, 43, 0.1);
}

.reader-heading {
  padding: 2rpx 3rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reader-title-group { min-width: 0; flex: 1; }
.reader-kicker { display: block; color: #ad6570; font-size: 16rpx; font-weight: 850; letter-spacing: 2rpx; }
.book-title { display: block; margin-top: 4rpx; overflow: hidden; color: #49372f; font-size: 29rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }

.favorite-button {
  width: 54rpx;
  height: 54rpx;
  min-height: 0;
  margin: 0 0 0 14rpx;
  padding: 0;
  flex: 0 0 auto;
  border: 0;
  border-radius: 50%;
  background: #f5eadb;
  color: #a78674;
  font-size: 31rpx;
  line-height: 54rpx;
  transition: opacity 150ms ease-out, transform 150ms ease-out, background 150ms ease-out;
}

.favorite-button::after { border: 0; }
.favorite-button-active { background: #f8dfe1; color: #bd5f70; }
.favorite-button:active { opacity: 0.72; transform: scale(0.94); }

.page-pill {
  margin-left: 18rpx;
  padding: 9rpx 15rpx;
  flex: 0 0 auto;
  border: 2rpx solid #e4c9a5;
  border-radius: 999rpx;
  background: #fff5e5;
  color: #8b6857;
  font-size: 18rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.book-paper {
  position: relative;
  min-height: 340rpx;
  padding: 15rpx;
  border: 2rpx solid #e8d7bd;
  border-radius: 20rpx;
  background: #f4ead8;
  box-shadow: inset 0 3rpx 10rpx rgba(91, 60, 43, 0.08);
}

.book-image {
  width: 100%;
  display: block;
  border-radius: 12rpx;
  background: #eee1ce;
  box-shadow: 0 7rpx 18rpx rgba(77, 49, 35, 0.12);
}

.paper-tape {
  position: absolute;
  top: -9rpx;
  z-index: 2;
  width: 66rpx;
  height: 23rpx;
  background: rgba(236, 197, 119, 0.65);
  box-shadow: 0 2rpx 5rpx rgba(96, 66, 38, 0.08);
}

.paper-tape-left { left: 38rpx; transform: rotate(-4deg); }
.paper-tape-right { right: 38rpx; transform: rotate(4deg); }

.reading-progress { margin: 22rpx 4rpx 0; }
.progress-copy { display: flex; justify-content: space-between; color: #8f7465; font-size: 17rpx; }
.progress-track { height: 9rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #eee0ca; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #e59a68, #c96968); transition: width 220ms ease-out; }

.page-controls {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.page-btn {
  min-height: 76rpx;
  margin: 0;
  padding: 0 22rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border: 0;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
  transition: opacity 150ms ease-out, transform 150ms ease-out;
}

.page-btn::after { border: 0; }
.page-btn-secondary { border: 2rpx solid #dec5a4; background: #fff6e8; color: #795c4d; }
.page-btn-primary { background: #aa5d68; color: #fff; box-shadow: 0 6rpx 14rpx rgba(151, 69, 82, 0.18); }
.page-btn:active { opacity: 0.78; transform: scale(0.98); }
.page-btn[disabled] { background: #eee6d9; color: #b2a294; box-shadow: none; opacity: 1; }
.control-arrow { margin-top: -3rpx; font-size: 38rpx; font-weight: 500; }

@keyframes pageEnter {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 340px) {
  .book-shell { padding-left: 22rpx; padding-right: 22rpx; }
  .book-shelf { width: calc(100% + 44rpx); margin-left: -22rpx; }
  .shelf-track { padding: 0 22rpx; }
  .shelf-book { width: 204rpx; }
  .cover-frame { height: 205rpx; }
  .reader-card { padding: 20rpx; }
  .page-btn { padding: 0 14rpx; font-size: 20rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .book-shell, .shelf-book, .favorite-button, .progress-fill, .page-btn { animation: none; transition: none; }
}
