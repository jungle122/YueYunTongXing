<view class="hub-page games-page {{isPageEntering ? 'page-enter-active' : ''}}">
  <view class="page-intro games-hero">
    <text class="chapter-seal">第二章</text>
    <text class="intro-title">今天想挑战哪一关？</text>
    <text class="hero-ornament">★</text>
  </view>

  <text class="section-caption">选择游戏</text>
  <view class="feature-list">
    <view class="feature-card chain-card" bindtap="startChain" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="开始童谣接龙">
      <view class="feature-main">
        <image class="feature-symbol chain-symbol" src="/static/ui/games/童谣接龙.jpg" mode="aspectFit" />
        <view class="feature-copy">
          <text class="feature-title">童谣接龙</text>
          <text class="feature-description">接出下一句歌词</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="game-meta">
        <view class="difficulty-row">
          <text class="meta-label">难度</text>
          <view class="difficulty-dots" aria-label="难度三颗星">
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot active-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="feature-card match-card" bindtap="startElimination" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="开始童谣消消乐">
      <view class="feature-main">
        <image class="feature-symbol match-symbol" src="/static/ui/games/童谣消消乐.jpg" mode="aspectFit" />
        <view class="feature-copy">
          <text class="feature-title">童谣消消乐</text>
          <text class="feature-description">翻牌配对相同词语</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="game-meta">
        <view class="difficulty-row">
          <text class="meta-label">难度</text>
          <view class="difficulty-dots" aria-label="难度两颗星">
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="feature-card puzzle-card" bindtap="startPuzzle" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="开始歌词挑战">
      <view class="feature-main">
        <image class="feature-symbol puzzle-symbol" src="/static/ui/games/童谣拼图.jpg" mode="aspectFit" />
        <view class="feature-copy">
          <text class="feature-title">歌词挑战</text>
          <text class="feature-description">逐字找词或整句排序</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="game-meta">
        <view class="difficulty-row">
          <text class="meta-label">难度</text>
          <view class="difficulty-dots" aria-label="难度两颗星">
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="feature-card picture-puzzle-card" bindtap="startPicturePuzzle" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="开始绘本拼图">
      <view class="feature-main">
        <image class="feature-symbol picture-puzzle-symbol" src="/static/ui/games/picture-puzzle.png" mode="aspectFit" />
        <view class="feature-copy">
          <text class="feature-title">绘本拼图</text>
          <text class="feature-description">听童谣，挑战3×3拼图</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="game-meta">
        <view class="difficulty-row">
          <text class="meta-label">难度</text>
          <view class="difficulty-dots" aria-label="难度两颗星">
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot active-dot"></view>
            <view class="difficulty-dot"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
