.games-hero {
  border-color: #bcdcb7;
  background: linear-gradient(145deg, #eef9df 0%, #e3f5df 100%);
}

.games-hero .chapter-seal { color: #4f7b4d; }

.chain-card { border-left: 8rpx solid #ed9b4b; }
.match-card { border-left: 8rpx solid #7ba9dc; }
.puzzle-card { border-left: 8rpx solid #72b57f; }
.picture-puzzle-card { border-left: 8rpx solid #668eaf; }

.chain-symbol { background: #ffe7c9; }
.match-symbol { background: #e0effc; }
.puzzle-symbol { background: #ddf2df; }
.picture-puzzle-symbol { background: #e2edf6; }

.game-meta {
  margin-top: 20rpx;
  padding-top: 17rpx;
  border-top: 2rpx dashed #eadac2;
}

.difficulty-row,
.difficulty-dots {
  display: flex;
  align-items: center;
}

.difficulty-row {
  min-height: 40rpx;
}

.meta-label {
  margin-right: 14rpx;
  color: #765f54;
  font-size: 21rpx;
  font-weight: 650;
}

.difficulty-dots {
  gap: 8rpx;
}

.difficulty-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ded2bf;
}

.active-dot {
  background: #efb841;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
}

/* 初版分层入场动画，使用显式 class 以便 TabBar 页面再次显示时重播。 */
.games-page.page-enter-active {
  animation: pageEnter-games 450ms ease-out;
}

.games-page.page-enter-active .games-hero {
  animation: headerPopIn-games 400ms cubic-bezier(0.34, 1.56, 0.64, 1) 100ms both;
}

.games-page.page-enter-active .section-caption,
.games-page.page-enter-active .feature-list {
  animation: contentFadeUp-games 450ms ease-out 120ms both;
}

.games-page.page-enter-active .feature-card:nth-child(1) {
  animation: cardSpringIn-games 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 180ms both;
}

.games-page.page-enter-active .feature-card:nth-child(2) {
  animation: cardSpringIn-games 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 300ms both;
}

.games-page.page-enter-active .feature-card:nth-child(3) {
  animation: cardSpringIn-games 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 420ms both;
}

.games-page.page-enter-active .feature-card:nth-child(4) {
  animation: cardSpringIn-games 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 540ms both;
}

@keyframes pageEnter-games {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes headerPopIn-games {
  from { opacity: 0; transform: scale(0.7) translateY(-30rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes contentFadeUp-games {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes cardSpringIn-games {
  0% { opacity: 0; transform: translateY(100rpx) scale(0.85) rotate(-3deg); }
  50% { opacity: 1; transform: translateY(-16rpx) scale(1.04) rotate(1deg); }
  70% { transform: translateY(6rpx) scale(0.98) rotate(-0.5deg); }
  100% { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); }
}

@media (prefers-reduced-motion: reduce) {
  .games-page.page-enter-active,
  .games-page.page-enter-active .games-hero,
  .games-page.page-enter-active .section-caption,
  .games-page.page-enter-active .feature-list,
  .games-page.page-enter-active .feature-card {
    animation: none;
  }
}
