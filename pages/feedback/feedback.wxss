.feedback-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 94% 4%, rgba(244, 190, 80, 0.22), transparent 26%),
    radial-gradient(circle at 2% 42%, rgba(224, 126, 98, 0.1), transparent 20%),
    #fff7e8;
}

.feedback-hero {
  border-color: #d4b8e8;
  background: linear-gradient(145deg, #f5eef8 0%, #eedcf6 100%);
}

.feedback-hero .chapter-seal { color: #8b5ca8; }

/* 反馈表单 */
.feedback-form-card {
  padding: 28rpx;
  border: 2rpx solid #ead5b5;
  border-radius: 28rpx;
  background: #fffdf5;
  box-shadow: 0 10rpx 24rpx rgba(104, 66, 43, 0.08);
}

.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #634b40;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.type-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.type-tag {
  padding: 14rpx 24rpx;
  border: 2rpx solid #e6cba8;
  border-radius: 20rpx;
  background: #fff9ed;
  font-size: 22rpx;
  color: #634b40;
  font-weight: 600;
  transition: all 0.2s ease;
}

.type-selected {
  border-color: #cf684b;
  background: rgba(207, 104, 75, 0.1);
  color: #cf684b;
}

.feedback-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e6cba8;
  border-radius: 18rpx;
  background: #fff9ed;
  font-size: 24rpx;
  color: #49352d;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #a08d82;
}

.contact-input {
  padding: 18rpx 20rpx;
  border: 2rpx solid #e6cba8;
  border-radius: 18rpx;
  background: #fff9ed;
  font-size: 24rpx;
  color: #49352d;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #cf684b, #e8a87c);
  color: #fff;
  font-size: 28rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(207, 104, 75, 0.25);
  margin-top: 10rpx;
}

.submit-disabled {
  opacity: 0.5;
}

.submit-btn-press {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 反馈列表 */
.feedback-list-card {
  padding: 20rpx 24rpx;
  border: 2rpx solid #ead5b5;
  border-radius: 28rpx;
  background: #fffdf5;
  box-shadow: 0 10rpx 24rpx rgba(104, 66, 43, 0.08);
}

.feedback-item {
  padding: 20rpx 0;
  border-bottom: 2rpx dashed #eadbc4;
}

.feedback-item:last-child {
  border-bottom: none;
}

.feedback-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.feedback-type-badge {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.type-suggestion {
  background: #fff3e0;
  color: #e67e22;
}

.type-bug {
  background: #fde8e8;
  color: #e74c3c;
}

.type-praise {
  background: #e8f8e8;
  color: #27ae60;
}

.type-other {
  background: #e8f0fd;
  color: #3498db;
}

.feedback-status {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.status-pending {
  background: #fff3e0;
  color: #e67e22;
}

.status-replied {
  background: #e8f8e8;
  color: #27ae60;
}

.status-processing {
  background: #e8f0fd;
  color: #3498db;
}

.feedback-content-text {
  display: block;
  font-size: 24rpx;
  color: #49352d;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.feedback-item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feedback-time {
  font-size: 20rpx;
  color: #a08d82;
}

.feedback-reply {
  font-size: 20rpx;
  color: #27ae60;
  font-weight: 600;
}

/* 通用 */
.empty-hint {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #a08d82;
  font-size: 24rpx;
}

@media (max-width: 340px) {
  .feedback-page { padding-left: 22rpx; padding-right: 22rpx; }
  .type-tag { padding: 12rpx 18rpx; font-size: 20rpx; }
}
