.rating-options { display: flex; gap: 8rpx; }
.rating-star { margin: 0; padding: 8rpx; min-width: 76rpx; background: transparent; font-size: 46rpx; line-height: 1.4; color: var(--color-text-muted); }
.rating-star::after { border: 0; }
.rating-selected { color: var(--color-primary); }
.rating-description, .feedback-rating { display: block; margin: 12rpx 0; font-size: 25rpx; color: var(--color-text-secondary); }
.admin-entry { margin-top: 32rpx; color: var(--color-text); font-size: 26rpx; background: var(--color-surface-soft); }
.feedback-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 94% 4%, rgba(244, 190, 80, 0.088), transparent 26%),
    radial-gradient(circle at 2% 42%, rgba(224, 126, 98, 0.04), transparent 20%),
    var(--color-bg);
}

.feedback-hero {
  border-color: var(--color-primary-border);
  background: var(--color-primary-soft);
}

.feedback-hero .chapter-seal { color: var(--color-primary); }

/* 反馈表单 */
.feedback-form-card {
  padding: 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}

.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.type-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.type-tag {
  padding: 14rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-label);
  background: #fff9ed;
  font-size: 22rpx;
  color: var(--color-text);
  font-weight: 600;
  transition: all 0.2s ease;
}

.type-selected {
  border-color: var(--color-primary);
  background: rgba(207, 104, 75, 0.1);
  color: var(--color-primary);
}

.feedback-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  background: #fff9ed;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.contact-input {
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  background: #fff9ed;
  font-size: 24rpx;
  color: var(--color-text);
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 28rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
  box-shadow: none;
  margin-top: 10rpx;
}

.submit-disabled {
  opacity: 0.5;
}

.submit-btn-press {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 反馈列表 */
.feedback-list-card {
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}

.feedback-item {
  padding: 20rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
}

.feedback-item:last-child {
  border-bottom: none;
}

.feedback-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.feedback-type-badge {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-label);
  font-size: 20rpx;
  font-weight: 700;
}

.type-suggestion {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.type-bug {
  background: var(--color-error-soft);
  color: var(--color-error);
}

.type-praise {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.type-other {
  background: var(--color-info-soft);
  color: var(--color-info);
}

.feedback-status {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.status-new,
.status-pending {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.status-resolved,
.status-replied {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-processing {
  background: var(--color-info-soft);
  color: var(--color-info);
}

.status-unknown {
  background: #f1eeee;
  color: #786d69;
}

.feedback-content-text {
  display: block;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.feedback-item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feedback-time {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.feedback-reply {
  font-size: 20rpx;
  color: var(--color-success);
  font-weight: 600;
}

.loading-hint,
.load-error {
  padding: 24rpx 12rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.load-error {
  border: 2rpx solid #f0cfbf;
  border-radius: 16rpx;
  background: #fff3ed;
  color: var(--color-error);
}

.retry-link {
  margin-left: 16rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.legacy-divider {
  margin-top: 20rpx;
  padding: 18rpx 0 10rpx;
  border-top: 2rpx solid var(--color-border);
  color: var(--color-text-muted);
  font-size: 21rpx;
  font-weight: 700;
}

.legacy-feedback-item {
  opacity: 0.82;
}

/* 通用 */
.empty-hint {
  text-align: center;
  padding: 40rpx 20rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

@media (max-width: 340px) {
  .feedback-page { padding-left: 22rpx; padding-right: 22rpx; }
  .type-tag { padding: 12rpx 18rpx; font-size: 20rpx; }
}

/* 主操作统一使用品牌陶土红；按下和禁用状态与章节色分离。 */
.submit-btn:active { background: var(--color-primary-pressed); }
.submit-btn[disabled] { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }

.submit-disabled { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }

.feedback-textarea:focus, .contact-input:focus { border-color: var(--color-primary); }
