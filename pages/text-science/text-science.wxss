.knowledge-page {
  min-height: 100vh;
  color: #49372f;
  background:
    radial-gradient(circle at 94% 3%, rgba(228, 153, 77, 0.2), transparent 24%),
    radial-gradient(circle at 2% 46%, rgba(118, 166, 128, 0.1), transparent 20%),
    #fff8eb;
}

.knowledge-shell {
  min-height: 100vh;
  padding: 24rpx 28rpx 76rpx;
  box-sizing: border-box;
}

.section-label {
  display: block;
  margin: 0 6rpx 16rpx;
  color: #6b5043;
  font-size: 24rpx;
  font-weight: 850;
  letter-spacing: 2rpx;
}

.featured-card {
  position: relative;
  min-height: 334rpx;
  padding: 36rpx 34rpx 28rpx;
  overflow: hidden;
  border: 3rpx solid rgba(114, 75, 50, 0.12);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 34rpx rgba(92, 58, 39, 0.12);
  box-sizing: border-box;
  transition: opacity 160ms ease-out, transform 160ms ease-out;
}

.featured-watermark {
  position: absolute;
  right: 22rpx;
  top: 24rpx;
  color: rgba(84, 54, 39, 0.12);
  font-size: 136rpx;
  font-weight: 900;
  line-height: 1;
  transform: rotate(-9deg);
}

.featured-kicker { position: relative; color: #8a5c3e; font-size: 20rpx; font-weight: 800; letter-spacing: 1rpx; }
.featured-title { position: relative; width: 82%; display: block; margin-top: 22rpx; color: #47342b; font-size: 38rpx; font-weight: 900; line-height: 1.35; }
.featured-subtitle { position: relative; width: 82%; display: block; margin-top: 12rpx; color: #765d50; font-size: 22rpx; line-height: 1.55; }
.featured-footer { position: relative; margin-top: 30rpx; display: flex; justify-content: space-between; color: #7d6253; font-size: 20rpx; font-weight: 700; }
.featured-progress { position: relative; height: 7rpx; margin-top: 14rpx; overflow: hidden; border-radius: 999rpx; background: rgba(98, 68, 49, 0.12); }
.featured-progress-fill { height: 100%; border-radius: inherit; background: #c86d4c; }
.card-press { opacity: 0.78; transform: scale(0.985); }

.more-label { margin-top: 36rpx; }
.article-list { overflow: hidden; border: 2rpx solid #ead9be; border-radius: 28rpx; background: rgba(255, 254, 249, 0.96); box-shadow: 0 12rpx 28rpx rgba(93, 61, 42, 0.08); }
.article-row { position: relative; min-height: 186rpx; padding: 24rpx 20rpx; display: flex; align-items: center; box-sizing: border-box; transition: opacity 150ms ease-out, background-color 150ms ease-out; }
.article-row + .article-row::before { content: ""; position: absolute; left: 132rpx; right: 20rpx; top: 0; height: 2rpx; background: #f0e4d2; }
.row-press { opacity: 0.72; background: #fff4df; }
.article-icon { width: 92rpx; height: 108rpx; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 18rpx 18rpx 24rpx 18rpx; overflow: hidden; }
.article-icon image { width: 100%; height: 100%; }
.article-copy { flex: 1; min-width: 0; }
.article-heading { display: flex; align-items: center; }
.article-title { overflow: hidden; color: #49372f; font-size: 27rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.collected-mark { margin-left: 9rpx; color: #d4665e; font-size: 20rpx; }
.article-subtitle { display: -webkit-box; margin-top: 7rpx; overflow: hidden; color: #887166; font-size: 20rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.article-meta { margin-top: 11rpx; display: flex; justify-content: space-between; color: #a08776; font-size: 18rpx; }
.row-progress { width: 176rpx; height: 6rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #efe3d1; }
.row-progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #e99a52, #d36650); }
.row-arrow { margin-left: 14rpx; color: #b48067; font-size: 42rpx; }

.theme-history { background: linear-gradient(145deg, #f7dda0, #eab96a); }
.theme-festival { background: linear-gradient(145deg, #f4c9bd, #e59b82); }
.theme-language { background: linear-gradient(145deg, #cce3cd, #8fbd98); }
.theme-modern { background: linear-gradient(145deg, #c9dee2, #91bdc6); }

@media (max-width: 340px) {
  .knowledge-shell { padding-left: 22rpx; padding-right: 22rpx; }
  .featured-card { padding-left: 28rpx; padding-right: 28rpx; }
  .featured-title, .featured-subtitle { width: 88%; }
  .article-icon { width: 82rpx; margin-right: 16rpx; }
  .article-row + .article-row::before { left: 118rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .featured-card, .article-row { transition: none; }
}
