<view class="knowledge-page">
  <view class="knowledge-shell">
    <text class="section-label">本期推荐</text>

    <view
      wx:if="{{featuredArticle}}"
      class="featured-card {{featuredArticle.themeClass}}"
      bindtap="openArticle"
      data-id="{{featuredArticle.id}}"
      hover-class="card-press"
      hover-stay-time="120"
      aria-role="button"
      aria-label="阅读{{featuredArticle.title}}"
    >
      <view class="featured-watermark">{{featuredArticle.icon}}</view>
      <text class="featured-kicker">岭南童谣小报 · {{featuredArticle.sectionName}}</text>
      <text class="featured-title">{{featuredArticle.title}}</text>
      <text class="featured-subtitle">{{featuredArticle.subtitle}}</text>
      <view class="featured-footer">
        <text>约 {{featuredArticle.readTime}} 分钟</text>
        <text>{{featuredArticle.statusText}} ›</text>
      </view>
      <view class="featured-progress"><view class="featured-progress-fill" style="{{featuredArticle.progressStyle}}"></view></view>
    </view>

    <text class="section-label more-label">更多小知识</text>
    <view class="article-list">
      <view
        wx:for="{{articles}}"
        wx:for-item="article"
        wx:key="id"
        class="article-row"
        bindtap="openArticle"
        data-id="{{article.id}}"
        hover-class="row-press"
        hover-stay-time="120"
        aria-role="button"
        aria-label="阅读{{article.title}}"
      >
        <view class="article-icon {{article.themeClass}}"><image src="{{article.iconImage}}" mode="aspectFill"></image></view>
        <view class="article-copy">
          <view class="article-heading">
            <text class="article-title">{{article.title}}</text>
            <text wx:if="{{article.isCollected}}" class="collected-mark" aria-label="已收藏">♥</text>
          </view>
          <text class="article-subtitle">{{article.subtitle}}</text>
          <view class="article-meta">
            <text>约 {{article.readTime}} 分钟</text>
            <text>{{article.statusText}}</text>
          </view>
          <view class="row-progress"><view class="row-progress-fill" style="{{article.progressStyle}}"></view></view>
        </view>
        <text class="row-arrow" aria-hidden="true">›</text>
      </view>
    </view>
  </view>
</view>
