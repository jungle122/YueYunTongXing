.admin-page {
  padding: 30rpx;
  min-height: 100vh;
  background: #fff7e8;
}
.header { margin-bottom: 30rpx; }
.title { display: block; font-size: 36rpx; font-weight: 900; color: #49372f; }
.desc { display: block; margin-top: 10rpx; font-size: 24rpx; color: #8e7268; line-height: 1.5; }
.status-bar { padding: 20rpx; margin-bottom: 20rpx; border-radius: 16rpx; background: #e8f5e9; }
.status-text { font-size: 26rpx; color: #2e7d32; font-weight: 700; }
.upload-list { display: flex; flex-direction: column; gap: 16rpx; }
.upload-item { display: flex; align-items: center; padding: 20rpx; border-radius: 20rpx; background: #fffdf6; border: 2rpx solid #ead8bc; }
.upload-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.video-id { font-size: 22rpx; color: #a95d69; font-weight: 800; }
.video-title { font-size: 26rpx; color: #49372f; font-weight: 700; }
.upload-status { font-size: 22rpx; color: #999; }
.upload-status.done { color: #2e7d32; font-weight: 700; }
.upload-btn { padding: 0 24rpx; height: 64rpx; line-height: 64rpx; font-size: 24rpx; font-weight: 700; border-radius: 14rpx; background: #a95d69; color: #fff; border: none; }
.upload-btn.btn-done { background: #6f9a73; }
.batch-section { margin-top: 40rpx; text-align: center; }
.batch-btn { background: #cf684b; color: #fff; font-weight: 800; border-radius: 16rpx; font-size: 28rpx; }
