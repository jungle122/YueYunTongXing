.video-page {
  min-height: 100vh;
  color: var(--color-text);
  background:
    radial-gradient(circle at 94% 3%, rgba(232, 139, 154, 0.072), transparent 24%),
    radial-gradient(circle at 3% 44%, rgba(232, 174, 86, 0.048), transparent 20%),
    var(--color-bg);
}

.video-shell {
  min-height: 100vh;
  padding: 24rpx 28rpx 76rpx;
  box-sizing: border-box;
  animation: pageEnter 380ms ease-out both;
}

.library-hero {
  position: relative;
  min-height: 276rpx;
  padding: 30rpx 30rpx 26rpx;
  overflow: hidden;
  border: 2rpx solid #edc3c7;
  border-radius: var(--radius-card);
  background: linear-gradient(145deg, #fff2ef 0%, #ffe6e5 100%);
  box-shadow: none;
  box-sizing: border-box;
}

.hero-copy { position: relative; z-index: 1; width: 78%; display: flex; flex-direction: column; }
.hero-kicker { color: #a65866; font-size: 19rpx; font-weight: 850; letter-spacing: 3rpx; }
.hero-title { margin-top: 10rpx; color: var(--color-text); font-size: 36rpx; font-weight: 900; line-height: 1.3; }
.hero-description { margin-top: 11rpx; color: var(--color-text-secondary); font-size: 21rpx; line-height: 1.6; }
.hero-mark { position: absolute; right: 22rpx; top: 18rpx; color: rgba(161, 72, 86, 0.1); font-family: serif; font-size: 118rpx; font-weight: 900; transform: rotate(8deg); }

.hero-summary {
  position: relative;
  z-index: 1;
  width: 250rpx;
  margin-top: 22rpx;
  padding: 11rpx 18rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(180, 100, 112, 0.18);
  border-radius: var(--radius-card);
  background: rgba(255, 253, 246, 0.7);
  box-sizing: border-box;
}

.summary-item { flex: 1; display: flex; align-items: baseline; justify-content: center; gap: 6rpx; }
.summary-number { color: #9d5260; font-size: 27rpx; font-weight: 900; font-variant-numeric: tabular-nums; }
.summary-label { color: var(--color-text-muted); font-size: 17rpx; }
.summary-divider { width: 2rpx; height: 28rpx; background: #e7c9c7; }

.section-heading { margin: 34rpx 6rpx 18rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.section-title { display: block; color: var(--color-text); font-size: 27rpx; font-weight: 900; }
.section-description { display: block; margin-top: 4rpx; color: var(--color-text-muted); font-size: 18rpx; }
.section-count { color: var(--color-text-muted); font-size: 18rpx; }

.video-list { display: flex; flex-direction: column; gap: 18rpx; }
.video-card {
  min-height: 242rpx;
  padding: 18rpx;
  display: flex;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
  box-sizing: border-box;
  transition: border-color 180ms ease-out, transform 180ms ease-out, box-shadow 180ms ease-out;
}
.video-card-playing { border-color: #d98f9b; box-shadow: none; }

.video-cover {
  position: relative;
  width: 210rpx;
  height: 206rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 21rpx;
  box-shadow: none;
  transition: opacity 150ms ease-out, transform 150ms ease-out;
}
.cover-coral { background: linear-gradient(145deg, #f2aaa4, #d97478); }
.cover-honey { background: linear-gradient(145deg, #f3c878, #d89b47); }
.cover-sage { background: linear-gradient(145deg, #a8c99f, #6f9d75); }
.cover-sky { background: linear-gradient(145deg, #a6cad0, #6b9da7); }
.cover-press { opacity: 0.86; transform: scale(0.98); }

.cover-poster-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 210rpx;
  height: 206rpx;
  border-radius: 21rpx;
  z-index: 0;
}

.cover-order { position: absolute; left: 15rpx; top: 12rpx; color: rgba(255, 255, 255, 0.86); font-size: 19rpx; font-weight: 900; letter-spacing: 2rpx; text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.4); z-index: 1; }
.cover-play { position: absolute; left: 50%; top: 50%; width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255, 255, 255, 0.62); border-radius: 50%; background: rgba(83, 48, 39, 0.18); color: var(--color-white); font-size: 26rpx; font-weight: 900; transform: translate(-50%, -50%); backdrop-filter: blur(4px); z-index: 1; }
.cover-caption { position: absolute; left: 15rpx; right: 15rpx; bottom: 13rpx; overflow: hidden; color: rgba(255, 255, 255, 0.92); font-size: 15rpx; font-weight: 750; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.4); z-index: 1; }

.video-body { min-width: 0; padding: 3rpx 2rpx 2rpx 20rpx; flex: 1; display: flex; flex-direction: column; }
.video-title-row { display: flex; align-items: flex-start; }
.video-copy { min-width: 0; flex: 1; }
.video-title { display: block; overflow: hidden; color: var(--color-text); font-size: 25rpx; font-weight: 900; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.video-subtitle { display: block; margin-top: 4rpx; color: var(--color-text-muted); font-size: 18rpx; line-height: 1.4; }
.favorite-button { width: 52rpx; height: 52rpx; min-height: 0; margin: -5rpx -3rpx 0 8rpx; padding: 0; border: 0; border-radius: 50%; background: #f8eee2; color: var(--color-text-muted); font-size: 29rpx; line-height: 52rpx; }
.favorite-button::after, .watch-button::after, .close-player-btn::after, .fullscreen-button::after { border: 0; }
.favorite-button-active { background: #f8dfe1; color: #bd5f70; }

.video-description { display: -webkit-box; margin-top: 12rpx; overflow: hidden; color: var(--color-text-muted); font-size: 19rpx; line-height: 1.48; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.video-tags { margin-top: 11rpx; display: flex; flex-wrap: wrap; gap: 7rpx; }
.video-tag { padding: 4rpx 9rpx; border: 2rpx solid var(--color-border); border-radius: 999rpx; background: var(--color-bg); color: var(--color-text-muted); font-size: 15rpx; line-height: 1.2; }
.watch-button { min-height: 52rpx; margin: auto 0 0; padding: 0 17rpx; align-self: flex-start; display: flex; align-items: center; justify-content: center; border: 0; border-radius: var(--radius-control); background: var(--color-primary); color: var(--color-white); font-size: 18rpx; font-weight: 850; line-height: 1; box-shadow: none; }
.watch-button-playing { background: var(--color-primary);  color: var(--color-white); }
.watch-icon { margin-right: 8rpx; font-size: 17rpx; }
.favorite-button:active, .watch-button:active, .fullscreen-button:active, .close-player-btn:active { opacity: 0.72; transform: scale(0.97); }

.library-note { display: block; margin: 24rpx 18rpx 0; color: var(--color-text-muted); font-size: 18rpx; line-height: 1.55; text-align: center; }
.media-error-note { color: var(--color-error); }
.media-retry-link { margin-left: 14rpx; color: var(--color-primary); font-weight: 800; }

.favorite-toast { position: fixed; left: 50%; top: 50%; z-index: 3000; padding: 22rpx 32rpx; display: flex; align-items: center; gap: 10rpx; border: 2rpx solid rgba(255, 255, 255, 0.42); border-radius: var(--radius-overlay); color: var(--color-white); box-shadow: 0 14rpx 32rpx rgba(64, 42, 32, 0.22); transform: translate(-50%, -50%); animation: toastShow 280ms ease-out; }
.favorite-toast.success { background: #6f9a73; }
.favorite-toast.cancel { background: #a97d70; }
.toast-icon { font-size: 27rpx; }
.toast-message { font-size: 22rpx; font-weight: 800; }

.video-player-modal { position: fixed; inset: 0; z-index: 2000; padding: 30rpx; display: flex; align-items: center; justify-content: center; background: rgba(62, 43, 35, 0.58); box-sizing: border-box; }
.player-card { position: relative; width: 100%; max-width: 700rpx; overflow: hidden; border: 3rpx solid #ead1ad; border-radius: var(--radius-overlay); background: var(--color-surface); box-shadow: 0 24rpx 56rpx rgba(53, 35, 27, 0.28); animation: playerPop 300ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.player-card-portrait { max-width: 520rpx; }
.player-header { padding: 24rpx 26rpx 20rpx; display: flex; align-items: center; border-bottom: 2rpx solid #eee0cb; }
.player-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.player-kicker { color: #a7636e; font-size: 16rpx; font-weight: 850; letter-spacing: 2rpx; }
.player-title { margin-top: 4rpx; overflow: hidden; color: var(--color-text); font-size: 27rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.close-player-btn { width: 54rpx; height: 54rpx; min-height: 0; margin: 0 0 0 14rpx; padding: 0; border: 0; border-radius: 50%; background: #f1e3d3; color: var(--color-text-secondary); font-size: 31rpx; line-height: 52rpx; }
.video-player { width: 100%; height: 390rpx; display: block; background: #1f1a17; }
.video-player-portrait { height: 760rpx; }
.player-status-layer { position: absolute; left: 0; right: 0; top: 101rpx; height: 390rpx; z-index: 3; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36rpx; color: var(--color-bg); background: rgba(31, 26, 23, 0.78); box-sizing: border-box; }
.player-card-portrait .player-status-layer { height: 760rpx; }
.loading-film { height: 44rpx; display: flex; align-items: center; gap: 8rpx; }
.loading-film-frame { width: 24rpx; height: 34rpx; border: 3rpx solid rgba(255, 248, 237, 0.82); border-radius: 5rpx; animation: filmLoading 900ms ease-in-out infinite; }
.loading-film-frame:nth-child(2) { animation-delay: 120ms; }
.loading-film-frame:nth-child(3) { animation-delay: 240ms; }
.player-status-title { margin-top: 18rpx; font-size: 24rpx; font-weight: 900; }
.player-status-description { margin-top: 8rpx; color: rgba(255, 248, 237, 0.76); font-size: 18rpx; text-align: center; }
.player-retry-button { min-height: 54rpx; margin-top: 22rpx; padding: 0 22rpx; border: 2rpx solid rgba(255, 248, 237, 0.54); border-radius: var(--radius-control); background: var(--color-primary); color: var(--color-white); font-size: 18rpx; font-weight: 850; line-height: 52rpx; }
.player-retry-button::after { border: 0; }
.player-placeholder { min-height: 360rpx; padding: 44rpx 50rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(145deg, var(--color-text), #342824); box-sizing: border-box; }
.placeholder-symbol { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255, 255, 255, 0.38); border-radius: 50%; background: rgba(255, 255, 255, 0.1); color: var(--color-white); font-size: 30rpx; }
.placeholder-title { margin-top: 20rpx; color: var(--color-bg); font-size: 27rpx; font-weight: 900; }
.placeholder-description { max-width: 470rpx; margin-top: 10rpx; color: rgba(255, 248, 237, 0.7); font-size: 20rpx; line-height: 1.6; text-align: center; }
.player-footer { min-height: 86rpx; padding: 16rpx 24rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.player-tags { display: flex; flex-wrap: wrap; gap: 7rpx; }
.player-tag { padding: 5rpx 10rpx; border-radius: 999rpx; background: #f1e2d0; color: var(--color-text-secondary); font-size: 15rpx; }
.fullscreen-button { min-height: 54rpx; margin: 0 0 0 14rpx; padding: 0 18rpx; border: 0; border-radius: var(--radius-control); background: var(--color-primary); color: var(--color-white); font-size: 18rpx; font-weight: 850; line-height: 54rpx; }

@keyframes pageEnter { from { opacity: 0; transform: translateY(22rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes toastShow { from { opacity: 0; transform: translate(-50%, -50%) scale(0.86); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
@keyframes playerPop { from { opacity: 0; transform: scale(0.86); } to { opacity: 1; transform: scale(1); } }
@keyframes filmLoading { 0%, 100% { opacity: 0.38; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-7rpx); } }

@media (max-width: 340px) {
  .video-shell { padding-left: 22rpx; padding-right: 22rpx; }
  .library-hero { padding-left: 25rpx; padding-right: 25rpx; }
  .hero-copy { width: 84%; }
  .video-card { flex-direction: column; }
  .video-cover { width: 100%; height: 250rpx; }
  .cover-poster-img { width: 100%; height: 250rpx; }
  .video-body { padding: 20rpx 3rpx 2rpx; }
  .watch-button { margin-top: 16rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .video-shell, .video-card, .video-cover, .favorite-toast, .player-card, .loading-film-frame { animation: none; transition: none; }
}

/* 主操作统一使用品牌陶土红；按下和禁用状态与章节色分离。 */
.watch-button:active,
.watch-button-playing:active,
.player-retry-button:active,
.fullscreen-button:active { background: var(--color-primary-pressed); }
.watch-button[disabled],
.watch-button-playing[disabled],
.player-retry-button[disabled],
.fullscreen-button[disabled] { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }
