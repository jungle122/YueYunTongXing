<view class="chain-game-page">
  <view class="game-shell">
    <view class="round-overview">
      <view class="round-copy">
        <text class="round-kicker">童谣记忆挑战</text>
        <text class="round-title">第 {{currentRound + 1}} 关</text>
      </view>
      <view class="score-cells">
        <view class="score-cell">
          <text class="score-number">{{score}}</text>
          <text class="score-label">得分</text>
        </view>
        <view class="score-divider"></view>
        <view class="score-cell">
          <text class="score-number">{{streak}}</text>
          <text class="score-label">连胜</text>
        </view>
      </view>
    </view>

    <view class="round-progress" aria-label="当前第{{currentRound + 1}}关，共3关">
      <view wx:for="{{selectedGames}}" wx:for-item="game" wx:for-index="roundIndex" wx:key="title" class="round-dot {{currentRound >= roundIndex ? 'round-dot-active' : ''}}"></view>
    </view>

    <view class="challenge-card">
      <view class="challenge-heading">
        <view class="challenge-copy">
          <text class="challenge-hint">根据上一句，接出下一句</text>
          <text wx:if="{{currentQuestion}}" class="question-title">《{{currentQuestion.title}}》</text>
        </view>
      </view>

      <view class="chain-paper">
        <view wx:for="{{displayedChain}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="text" class="chain-row {{line.isLast ? 'chain-row-current' : ''}}">
          <view class="chain-marker">
            <view class="marker-dot"></view>
            <view wx:if="{{displayedChain.length - 1 > lineIndex}}" class="marker-line"></view>
          </view>
          <view class="chain-line">
            <text class="line-order">{{lineIndex + 1}}</text>
            <text class="line-text">{{line.text}}</text>
            <text wx:if="{{line.isLast && !showNextBtn}}" class="current-label">从这里接</text>
          </view>
        </view>

        <view wx:if="{{!showNextBtn}}" class="waiting-row">
          <view class="chain-marker"><view class="marker-dot waiting-dot"></view></view>
          <view class="waiting-line">下一句是……</view>
        </view>
      </view>

      <view wx:if="{{!showNextBtn}}" class="answer-panel">
        <text class="answer-label">轮到你啦，选择下一句</text>
        <view class="options-grid">
          <view wx:for="{{optionRows}}" wx:for-item="optionRow" wx:key="rowId" class="option-row">
            <view wx:for="{{optionRow.options}}" wx:for-item="opt" wx:key="optionIndex" class="option-card {{selectedOption === opt.optionIndex ? 'option-selected' : ''}}" bindtap="onSelectOption" data-index="{{opt.optionIndex}}">
              <text class="option-index">{{opt.optionIndex + 1}}</text>
              <text class="option-text">{{opt.text}}</text>
            </view>
          </view>
        </view>
        <view class="game-controls">
          <button class="control-btn primary-btn" bindtap="submitAnswer" disabled="{{gameOver || selectedOption === -1}}">提交答案</button>
          <button class="control-btn hint-btn" bindtap="showHint" disabled="{{gameOver}}">
            <text class="button-icon"></text>
            <text>给我提示</text>
          </button>
        </view>
      </view>

      <view wx:else class="round-complete">
        <view class="complete-mark">✓</view>
        <text class="complete-title">这一首接完啦</text>
        <text class="complete-copy">准备好就继续下一关</text>
        <button class="control-btn next-btn" bindtap="nextRound">{{currentRound + 1 >= selectedGames.length ? '查看成绩' : '下一题'}}</button>
      </view>
    </view>

    <text class="game-note">每答对一句得 10 分，连续答对还有加分</text>
  </view>

  <view wx:if="{{showResultModal}}" class="modal" bindtap="closeResultModal">
    <view class="modal-card correct-card" catchtap="noop">
      <view class="modal-symbol correct-symbol">✓</view>
      <text class="modal-title">接对了！</text>
      <text class="modal-text">这一句答得真好</text>
      <text class="score-reward">+{{currentScore}} 分</text>
      <button class="modal-btn" bindtap="closeResultModal">继续接龙</button>
    </view>
  </view>

  <view wx:if="{{showWrongModal}}" class="modal" bindtap="closeWrongModal">
    <view class="modal-card wrong-card" catchtap="noop">
      <view class="modal-symbol wrong-symbol">×</view>
      <text class="modal-title">差一点点</text>
      <text class="modal-text">正确的下一句是</text>
      <text class="answer-reveal">{{correctAnswer}}</text>
      <button class="modal-btn" bindtap="closeWrongModal">我记住了</button>
    </view>
  </view>

  <view wx:if="{{showGameOverModal}}" class="modal" bindtap="closeGameOverModal">
    <view class="modal-card" catchtap="noop">
      <view class="modal-symbol trophy-symbol">🏆</view>
      <text class="modal-title">挑战结束</text>
      <text class="modal-text">最终得分 {{score}} 分，最高连胜 {{bestStreak}}</text>
      <button class="modal-btn" bindtap="restartGame">再来一局</button>
    </view>
  </view>

  <view wx:if="{{showHintModal}}" class="modal" bindtap="closeHintModal">
    <view class="modal-card" catchtap="noop">
      <view class="modal-symbol hint-symbol">💡</view>
      <text class="modal-title">提示来了</text>
      <text class="modal-text">试试想这几个字开头的句子</text>
      <text class="answer-reveal">{{hintAnswer}}...</text>
      <button class="modal-btn" bindtap="closeHintModal">知道了</button>
    </view>
  </view>
</view>
