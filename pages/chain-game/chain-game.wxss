.chain-game-page {
  min-height: 100vh;
  color: var(--color-text);
  background:
    radial-gradient(circle at 92% 4%, rgba(235, 156, 91, 0.08), transparent 25%),
    radial-gradient(circle at 4% 58%, rgba(116, 171, 126, 0.048), transparent 20%),
    var(--color-bg);
  animation: gamePageEnter 380ms ease-out both;
}

.game-shell { min-height: 100vh; padding: 24rpx 28rpx 76rpx; box-sizing: border-box; }

.round-overview {
  min-height: 116rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: rgba(255, 253, 246, 0.94);
  box-shadow: none;
  box-sizing: border-box;
}
.round-copy { display: flex; flex-direction: column; }
.round-kicker { color: var(--color-text-muted); font-size: 19rpx; font-weight: 750; letter-spacing: 1rpx; }
.round-title { margin-top: 4rpx; color: var(--color-text); font-size: 31rpx; font-weight: 900; }
.score-cells { display: flex; align-items: center; }
.score-cell { min-width: 74rpx; display: flex; flex-direction: column; align-items: center; }
.score-number { color: #bf6849; font-size: 30rpx; font-weight: 900; font-variant-numeric: tabular-nums; }
.score-label { margin-top: 2rpx; color: var(--color-text-muted); font-size: 18rpx; }
.score-divider { width: 2rpx; height: 48rpx; margin: 0 8rpx; background: var(--color-border); }

.round-progress { margin: 20rpx 8rpx 24rpx; display: flex; gap: 10rpx; }
.round-dot { height: 8rpx; flex: 1; overflow: hidden; border-radius: 999rpx; background: var(--color-border); }
.round-dot-active { background: linear-gradient(90deg, #e9a052, #cd6a4e); }
.chain-game-page .game-music-toggle { background: var(--color-primary); box-shadow: none;  color: var(--color-white); }
.chain-game-page .game-music-toggle[disabled] { background: var(--color-disabled-bg); }

.challenge-card {
  padding: 28rpx 26rpx 30rpx;
  border: 2rpx solid #e8d5b7;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}
.challenge-heading { display: flex; align-items: center; }
.challenge-copy { flex: 1; min-width: 0; }
.challenge-hint { display: block; color: var(--color-text-muted); font-size: 19rpx; }
.question-title { display: block; margin-top: 5rpx; overflow: hidden; color: var(--color-text); font-size: 30rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }

.chain-paper {
  margin-top: 26rpx;
  padding: 24rpx 22rpx;
  border: 2rpx solid #eee0cb;
  border-radius: 24rpx;
  background:
    linear-gradient(rgba(132, 93, 67, 0.035) 2rpx, transparent 2rpx) 0 0 / 100% 58rpx,
    var(--color-surface);
}
.chain-row, .waiting-row { display: flex; align-items: stretch; }
.chain-row + .chain-row { margin-top: 12rpx; }
.chain-marker { position: relative; width: 30rpx; margin-right: 10rpx; display: flex; justify-content: center; flex-shrink: 0; }
.marker-dot { position: relative; z-index: 2; width: 14rpx; height: 14rpx; margin-top: 27rpx; border: 4rpx solid var(--color-surface); border-radius: 50%; background: #d6b69b; box-shadow: 0 0 0 2rpx #d6b69b; box-sizing: border-box; }
.marker-line { position: absolute; top: 35rpx; bottom: -27rpx; width: 3rpx; background: #e4cdb5; }
.chain-line { position: relative; min-height: 68rpx; padding: 15rpx 18rpx; display: flex; align-items: center; flex: 1; border: 2rpx solid transparent; border-radius: var(--radius-control); box-sizing: border-box; }
.line-order { width: 34rpx; height: 34rpx; margin-right: 12rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: #efe2d0; color: var(--color-text-muted); font-size: 17rpx; font-weight: 900; }
.line-text { flex: 1; color: #695348; font-size: 24rpx; line-height: 1.55; }
.chain-row-current .chain-line { border-color: #edc99d; background: #fff0d4; box-shadow: none; }
.chain-row-current .marker-dot { background: var(--color-primary); box-shadow: 0 0 0 2rpx var(--color-primary); animation: markerPulse 1.6s ease-in-out infinite; }
.chain-row-current .line-order { background: #d67852; color: var(--color-surface); }
.chain-row-current .line-text { color: var(--color-text); font-weight: 800; }
.current-label { margin-left: 10rpx; padding: 5rpx 9rpx; flex-shrink: 0; border-radius: 999rpx; background: rgba(201, 106, 76, 0.13); color: #ad5b43; font-size: 16rpx; font-weight: 800; }
.waiting-row { margin-top: 12rpx; min-height: 58rpx; align-items: center; }
.waiting-dot { margin-top: 21rpx; background: var(--color-border-strong); box-shadow: 0 0 0 2rpx var(--color-border-strong); }
.waiting-line { flex: 1; padding: 13rpx 18rpx; border: 2rpx dashed #dfcdb6; border-radius: var(--radius-control); color: var(--color-text-muted); font-size: 22rpx; text-align: left; }

.answer-panel { margin-top: 28rpx; padding-top: 26rpx; border-top: 2rpx dashed var(--color-border); }
.answer-label { display: block; margin: 0 4rpx 12rpx; color: var(--color-text); font-size: 23rpx; font-weight: 900; }
/* === 选项卡片 === */
.options-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 4rpx;
}
.option-row {
  width: 100%;
  display: flex;
  gap: 16rpx;
}
.option-card {
  width: 0;
  flex: 1;
  min-width: 0;
  padding: 22rpx 18rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  background: var(--color-surface);
  box-shadow: none;
  box-sizing: border-box;
  transition: all 150ms ease;
}
.option-card:active {
  opacity: 0.78;
  transform: scale(0.97);
}
.option-index {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #efe2d0;
  color: var(--color-text-muted);
  font-size: 18rpx;
  font-weight: 900;
}
.option-text {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 22rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.option-selected {
  border-color: var(--color-primary);
  background: #fff3ec;
  box-shadow: none;
}
.option-selected .option-index {
  background: var(--color-primary);
  color: var(--color-surface);
}
.option-selected .option-text {
  color: var(--color-text);
  font-weight: 700;
}

/* === 旧输入框（保留以防引用） === */
.answer-input { width: 100%; min-height: 92rpx; padding: 0 24rpx; border: 3rpx solid var(--color-border); border-radius: var(--radius-control); background: var(--color-surface); color: var(--color-text); font-size: 27rpx; line-height: 92rpx; box-sizing: border-box; }
.game-controls { margin-top: 18rpx; display: flex; gap: 14rpx; }
.control-btn { min-height: 82rpx; margin: 0; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 0; border-radius: var(--radius-control); font-size: 24rpx; font-weight: 850; line-height: 1; }
.control-btn::after, .modal-btn::after { border: 0; }
.primary-btn { flex: 1.35; background: var(--color-primary); color: var(--color-white); box-shadow: none; }
.hint-btn { flex: 1; border: 2rpx solid #e4c9a7; background: #fff1d7; color: #8a623f; }
.button-icon { margin-right: 8rpx; font-size: 27rpx; line-height: 1; }
.control-btn:active, .modal-btn:active { opacity: 0.72; transform: scale(0.98); }

.round-complete { margin-top: 28rpx; padding: 28rpx 22rpx 4rpx; display: flex; flex-direction: column; align-items: center; border-top: 2rpx dashed var(--color-border); }
.complete-mark { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #deefd8; color: #578754; font-size: 29rpx; font-weight: 900; }
.complete-title { margin-top: 12rpx; color: var(--color-text); font-size: 26rpx; font-weight: 900; }
.complete-copy { margin-top: 5rpx; color: var(--color-text-muted); font-size: 19rpx; }
.next-btn { width: 100%; margin-top: 20rpx; background: var(--color-primary); color: var(--color-white); box-shadow: none; }
.game-note { display: block; margin-top: 20rpx; color: var(--color-text-muted); font-size: 19rpx; text-align: center; }

.modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 34rpx; background: rgba(67, 46, 35, 0.46); box-sizing: border-box; }
.modal-card { width: 560rpx; padding: 42rpx 38rpx 36rpx; display: flex; flex-direction: column; align-items: center; border: 3rpx solid #ead1ad; border-radius: var(--radius-overlay); background: var(--color-surface); box-shadow: 0 22rpx 50rpx rgba(58, 38, 28, 0.22); box-sizing: border-box; animation: modalPop 300ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.modal-symbol { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 38rpx; font-weight: 900; }
.correct-symbol { background: var(--color-success-soft); color: var(--color-success); }
.wrong-symbol { background: var(--color-error-soft); color: var(--color-error); }
.trophy-symbol { background: #ffe9b8; color: #b77a2b; }
.hint-symbol { background: #fff0c7; color: #a76c31; }
.modal-title { margin-top: 18rpx; color: var(--color-text); font-size: 32rpx; font-weight: 900; }
.modal-text { margin-top: 10rpx; color: var(--color-text-muted); font-size: 22rpx; line-height: 1.6; text-align: center; }
.score-reward, .final-score { margin-top: 14rpx; color: #bd6448; font-size: 44rpx; font-weight: 900; }
.answer-reveal { width: 100%; margin-top: 14rpx; padding: 20rpx; border-radius: 18rpx; background: #fff0d8; color: var(--color-text); font-size: 26rpx; font-weight: 800; line-height: 1.55; text-align: center; box-sizing: border-box; }
.modal-btn { width: 100%; min-height: 78rpx; margin-top: 28rpx; padding: 0; border: 0; border-radius: var(--radius-control); background: var(--color-primary); color: var(--color-white); font-size: 24rpx; font-weight: 850; line-height: 78rpx; }
.game-over-card .modal-btn { background: var(--color-primary);  color: var(--color-white); }

@keyframes gamePageEnter { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes markerPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.35); } }
@keyframes modalPop { from { opacity: 0; transform: scale(0.84); } to { opacity: 1; transform: scale(1); } }

@media (max-width: 340px) {
  .game-shell { padding-left: 22rpx; padding-right: 22rpx; }
  .challenge-card { padding-left: 20rpx; padding-right: 20rpx; }
  .current-label { display: none; }
  .modal-card { padding-left: 30rpx; padding-right: 30rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .chain-game-page, .chain-row-current .marker-dot, .modal-card { animation: none; }
}

/* 主操作统一使用品牌陶土红；按下和禁用状态与章节色分离。 */
.primary-btn:active,
.next-btn:active,
.modal-btn:active,
.game-over-card .modal-btn:active,
.chain-game-page .game-music-toggle:active { background: var(--color-primary-pressed); }
.primary-btn[disabled],
.next-btn[disabled],
.modal-btn[disabled],
.game-over-card .modal-btn[disabled],
.chain-game-page .game-music-toggle[disabled] { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }
