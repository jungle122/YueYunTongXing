.chain-game-page {
  min-height: 100vh;
  color: #49372f;
  background:
    radial-gradient(circle at 92% 4%, rgba(235, 156, 91, 0.2), transparent 25%),
    radial-gradient(circle at 4% 58%, rgba(116, 171, 126, 0.12), transparent 20%),
    #fff8eb;
  animation: gamePageEnter 380ms ease-out both;
}

.game-shell { min-height: 100vh; padding: 24rpx 28rpx 76rpx; box-sizing: border-box; }

.round-overview {
  min-height: 116rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #ead8bc;
  border-radius: 26rpx;
  background: rgba(255, 253, 246, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(104, 66, 43, 0.08);
  box-sizing: border-box;
}
.round-copy { display: flex; flex-direction: column; }
.round-kicker { color: #9a7460; font-size: 19rpx; font-weight: 750; letter-spacing: 1rpx; }
.round-title { margin-top: 4rpx; color: #4d392f; font-size: 31rpx; font-weight: 900; }
.score-cells { display: flex; align-items: center; }
.score-cell { min-width: 74rpx; display: flex; flex-direction: column; align-items: center; }
.score-number { color: #bf6849; font-size: 30rpx; font-weight: 900; font-variant-numeric: tabular-nums; }
.score-label { margin-top: 2rpx; color: #9b8272; font-size: 18rpx; }
.score-divider { width: 2rpx; height: 48rpx; margin: 0 8rpx; background: #eadcc9; }

.round-progress { margin: 20rpx 8rpx 24rpx; display: flex; gap: 10rpx; }
.round-dot { height: 8rpx; flex: 1; overflow: hidden; border-radius: 999rpx; background: #eadfce; }
.round-dot-active { background: linear-gradient(90deg, #e9a052, #cd6a4e); }

.challenge-card {
  padding: 28rpx 26rpx 30rpx;
  border: 2rpx solid #e8d5b7;
  border-radius: 30rpx;
  background: #fffdf6;
  box-shadow: 0 14rpx 30rpx rgba(91, 58, 40, 0.1);
}
.challenge-heading { display: flex; align-items: center; }
.challenge-copy { flex: 1; min-width: 0; }
.challenge-hint { display: block; color: #9a8172; font-size: 19rpx; }
.question-title { display: block; margin-top: 5rpx; overflow: hidden; color: #49372f; font-size: 30rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }

.chain-paper {
  margin-top: 26rpx;
  padding: 24rpx 22rpx;
  border: 2rpx solid #eee0cb;
  border-radius: 24rpx;
  background:
    linear-gradient(rgba(132, 93, 67, 0.035) 2rpx, transparent 2rpx) 0 0 / 100% 58rpx,
    #fffaf0;
}
.chain-row, .waiting-row { display: flex; align-items: stretch; }
.chain-row + .chain-row { margin-top: 12rpx; }
.chain-marker { position: relative; width: 30rpx; margin-right: 10rpx; display: flex; justify-content: center; flex-shrink: 0; }
.marker-dot { position: relative; z-index: 2; width: 14rpx; height: 14rpx; margin-top: 27rpx; border: 4rpx solid #fffaf0; border-radius: 50%; background: #d6b69b; box-shadow: 0 0 0 2rpx #d6b69b; box-sizing: border-box; }
.marker-line { position: absolute; top: 35rpx; bottom: -27rpx; width: 3rpx; background: #e4cdb5; }
.chain-line { position: relative; min-height: 68rpx; padding: 15rpx 18rpx; display: flex; align-items: center; flex: 1; border: 2rpx solid transparent; border-radius: 18rpx; box-sizing: border-box; }
.line-order { width: 34rpx; height: 34rpx; margin-right: 12rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: #efe2d0; color: #927463; font-size: 17rpx; font-weight: 900; }
.line-text { flex: 1; color: #695348; font-size: 24rpx; line-height: 1.55; }
.chain-row-current .chain-line { border-color: #edc99d; background: #fff0d4; box-shadow: 0 5rpx 12rpx rgba(166, 105, 63, 0.09); }
.chain-row-current .marker-dot { background: #ce6a4b; box-shadow: 0 0 0 2rpx #ce6a4b; animation: markerPulse 1.6s ease-in-out infinite; }
.chain-row-current .line-order { background: #d67852; color: #fffaf1; }
.chain-row-current .line-text { color: #513b31; font-weight: 800; }
.current-label { margin-left: 10rpx; padding: 5rpx 9rpx; flex-shrink: 0; border-radius: 999rpx; background: rgba(201, 106, 76, 0.13); color: #ad5b43; font-size: 16rpx; font-weight: 800; }
.waiting-row { margin-top: 12rpx; min-height: 58rpx; align-items: center; }
.waiting-dot { margin-top: 21rpx; background: #d6cab9; box-shadow: 0 0 0 2rpx #d6cab9; }
.waiting-line { flex: 1; padding: 13rpx 18rpx; border: 2rpx dashed #dfcdb6; border-radius: 18rpx; color: #b29a88; font-size: 22rpx; text-align: left; }

.answer-panel { margin-top: 28rpx; padding-top: 26rpx; border-top: 2rpx dashed #e5d5bf; }
.answer-label { display: block; margin: 0 4rpx 12rpx; color: #634a3e; font-size: 23rpx; font-weight: 900; }
/* === 选项卡片 === */
.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 4rpx;
}
.option-card {
  width: calc(50% - 8rpx);
  padding: 22rpx 18rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #e6cfb0;
  border-radius: 18rpx;
  background: #fffaf0;
  box-shadow: 0 4rpx 10rpx rgba(104, 66, 43, 0.06);
  box-sizing: border-box;
  transition: all 150ms ease;
}
.option-card:active {
  opacity: 0.78;
  transform: scale(0.97);
}
.option-index {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #efe2d0;
  color: #927463;
  font-size: 18rpx;
  font-weight: 900;
}
.option-text {
  flex: 1;
  color: #5a4438;
  font-size: 22rpx;
  line-height: 1.45;
}
.option-selected {
  border-color: #c8654b;
  background: #fff3ec;
  box-shadow: 0 4rpx 14rpx rgba(200, 101, 75, 0.14);
}
.option-selected .option-index {
  background: #c8654b;
  color: #fffaf1;
}
.option-selected .option-text {
  color: #49372f;
  font-weight: 700;
}

/* === 旧输入框（保留以防引用） === */
.answer-input { width: 100%; min-height: 92rpx; padding: 0 24rpx; border: 3rpx solid #e6cfb0; border-radius: 22rpx; background: #fffaf0; color: #49372f; font-size: 27rpx; line-height: 92rpx; box-sizing: border-box; }
.game-controls { margin-top: 18rpx; display: flex; gap: 14rpx; }
.control-btn { min-height: 82rpx; margin: 0; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 22rpx; font-size: 24rpx; font-weight: 850; line-height: 1; }
.control-btn::after, .modal-btn::after { border: 0; }
.primary-btn { flex: 1.35; background: #c8654b; color: #fffaf1; box-shadow: 0 8rpx 18rpx rgba(160, 79, 57, 0.2); }
.hint-btn { flex: 1; border: 2rpx solid #e4c9a7; background: #fff1d7; color: #8a623f; }
.button-icon { margin-right: 8rpx; font-size: 27rpx; line-height: 1; }
.control-btn:active, .modal-btn:active { opacity: 0.72; transform: scale(0.98); }

.round-complete { margin-top: 28rpx; padding: 28rpx 22rpx 4rpx; display: flex; flex-direction: column; align-items: center; border-top: 2rpx dashed #e5d5bf; }
.complete-mark { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #deefd8; color: #578754; font-size: 29rpx; font-weight: 900; }
.complete-title { margin-top: 12rpx; color: #4d3a31; font-size: 26rpx; font-weight: 900; }
.complete-copy { margin-top: 5rpx; color: #9b8374; font-size: 19rpx; }
.next-btn { width: 100%; margin-top: 20rpx; background: #739e70; color: #fff; box-shadow: 0 8rpx 18rpx rgba(75, 119, 72, 0.18); }
.game-note { display: block; margin-top: 20rpx; color: #a08775; font-size: 19rpx; text-align: center; }

.modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 34rpx; background: rgba(67, 46, 35, 0.46); box-sizing: border-box; }
.modal-card { width: 560rpx; padding: 42rpx 38rpx 36rpx; display: flex; flex-direction: column; align-items: center; border: 3rpx solid #ead1ad; border-radius: 30rpx; background: #fffaf0; box-shadow: 0 22rpx 50rpx rgba(58, 38, 28, 0.22); box-sizing: border-box; animation: modalPop 300ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.modal-symbol { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 38rpx; font-weight: 900; }
.correct-symbol { background: #dcefd7; color: #4f854e; }
.wrong-symbol { background: #f6dcd2; color: #bb5c4c; }
.trophy-symbol { background: #ffe9b8; color: #b77a2b; }
.hint-symbol { background: #fff0c7; color: #a76c31; }
.modal-title { margin-top: 18rpx; color: #4a372e; font-size: 32rpx; font-weight: 900; }
.modal-text { margin-top: 10rpx; color: #907565; font-size: 22rpx; line-height: 1.6; text-align: center; }
.score-reward, .final-score { margin-top: 14rpx; color: #bd6448; font-size: 44rpx; font-weight: 900; }
.answer-reveal { width: 100%; margin-top: 14rpx; padding: 20rpx; border-radius: 18rpx; background: #fff0d8; color: #594238; font-size: 26rpx; font-weight: 800; line-height: 1.55; text-align: center; box-sizing: border-box; }
.modal-btn { width: 100%; min-height: 78rpx; margin-top: 28rpx; padding: 0; border: 0; border-radius: 22rpx; background: #c8654b; color: #fffaf1; font-size: 24rpx; font-weight: 850; line-height: 78rpx; }
.game-over-card .modal-btn { background: #739e70; }

@keyframes gamePageEnter { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes markerPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.35); } }
@keyframes modalPop { from { opacity: 0; transform: scale(0.84); } to { opacity: 1; transform: scale(1); } }

@media (max-width: 340px) {
  .game-shell { padding-left: 22rpx; padding-right: 22rpx; }
  .challenge-card { padding-left: 20rpx; padding-right: 20rpx; }
  .current-label { display: none; }
  .modal-card { padding-left: 30rpx; padding-right: 30rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .chain-game-page, .chain-row-current .marker-dot, .modal-card { animation: none; }
}
