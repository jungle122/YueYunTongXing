<view class="hub-page original-page {{isPageEntering ? 'page-enter-active' : ''}}">
  <view class="page-intro original-hero">
    <text class="chapter-seal">第三章</text>
    <text class="intro-title">一起看看会唱歌的故事</text>
    <text class="intro-description">从画面和故事出发，感受粤语童谣里的生活气息。</text>
    <text class="hero-ornament">✿</text>
  </view>

  <text class="section-caption">原创作品</text>
  <view class="feature-list">
    <view class="feature-card video-card" bindtap="goVideo" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="观看原创童谣视频">
      <view class="feature-main">
        <view class="feature-symbol video-symbol"><image src="/static/ui/original/原创视频.jpg"></image></view>
        <view class="feature-copy">
          <text class="feature-title">原创视频</text>
          <text class="feature-description">观看原创粤语童谣视频，在声音和画面中体验传统文化。</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="original-tags">
        <text class="original-tag">视频</text>
        <text class="original-tag">原创</text>
        <text class="original-tag">童谣</text>
      </view>
    </view>

    <view class="feature-card book-card" bindtap="goBook" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="阅读原创童谣绘本">
      <view class="feature-main">
        <view class="feature-symbol book-symbol"><image src="/static/ui/original/绘本故事.jpg"></image></view>
        <view class="feature-copy">
          <text class="feature-title">绘本故事</text>
          <text class="feature-description">在《氹氹转》《月光光》等经典故事里认识童谣。</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="original-tags">
        <text class="original-tag">绘本</text>
        <text class="original-tag">童谣</text>
        <text class="original-tag">故事</text>
      </view>
    </view>
    <view
      class="feature-card manual-card"
      bindtap="openManual"
      hover-class="soft-press"
      hover-stay-time="120"
      aria-role="button"
      aria-label="阅读童谣课程手册"
    >
      <view class="feature-main">
        <view class="feature-symbol manual-symbol"><image src="/static/ui/original/童谣课程手册.svg"></image></view>

        <view class="feature-copy">
          <text class="feature-title">童谣课程手册</text>
          <text class="feature-description">{{manualOpening ? '手册加载中，请稍候…' : '阅读粤语童谣课程设计与教学实践手册。'}}</text>
        </view>

        <text class="feature-arrow">›</text>
      </view>

      <view class="original-tags">
        <text class="original-tag">手册</text>
        <text class="original-tag">教案</text>
        <text class="original-tag">童谣</text>
      </view>
    </view>
  </view>
</view>
