.original-hero {
  border-color: var(--color-chapter-original-border);
  background: linear-gradient(145deg, var(--color-chapter-original-soft) 0%, #ffe7e8 100%);
}

.original-hero .chapter-seal { color: var(--color-chapter-original); }

.video-card { }
.book-card { }

.manual-card {
  }

.video-symbol { background: #ffe1e5; }
.book-symbol { background: #ddf3df; }

.original-tags {
  margin-top: 20rpx;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-top: 2rpx dashed var(--color-border);
}

.original-tag {
  padding: 7rpx 13rpx;
  border: 2rpx solid #dfc9aa;
  border-radius: var(--radius-label);
  background: #fff9ed;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  font-weight: 650;
}

/* 初版左右交错入场动画，使用显式 class 以便 TabBar 页面再次显示时重播。 */
.original-page.page-enter-active {
  animation: pageEnter-orig 500ms ease-out;
}

.original-page.page-enter-active .original-hero {
  animation: headerSlideLeft-orig 450ms ease-out 100ms both;
}

.original-page.page-enter-active .section-caption,
.original-page.page-enter-active .feature-list {
  animation: contentReveal-orig 500ms ease-out 150ms both;
}

.original-page.page-enter-active .feature-card:nth-child(1) {
  animation: cardSlideFromLeft-orig 550ms ease-out 200ms both;
}

.original-page.page-enter-active .feature-card:nth-child(2) {
  animation: cardSlideFromRight-orig 550ms ease-out 350ms both;
}

.original-page.page-enter-active .feature-card:nth-child(3) {
  animation: cardSlideFromLeft-orig 550ms ease-out 500ms both;
}

@keyframes pageEnter-orig {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes headerSlideLeft-orig {
  from { opacity: 0; transform: translateX(-50rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes contentReveal-orig {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes cardSlideFromLeft-orig {
  0% { opacity: 0; transform: translateX(-80rpx) scale(0.95); }
  70% { transform: translateX(8rpx) scale(1.01); }
  100% { opacity: 1; transform: translateX(0) scale(1); }
}

@keyframes cardSlideFromRight-orig {
  0% { opacity: 0; transform: translateX(80rpx) scale(0.95); }
  70% { transform: translateX(-8rpx) scale(1.01); }
  100% { opacity: 1; transform: translateX(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .original-page.page-enter-active,
  .original-page.page-enter-active .original-hero,
  .original-page.page-enter-active .section-caption,
  .original-page.page-enter-active .feature-list,
  .original-page.page-enter-active .feature-card {
    animation: none;
  }
}

.feature-symbol image {
  width: 100%;
  height: 100%;
}
