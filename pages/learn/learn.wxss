.learn-hero {
  border-color: #ecd08a;
  background: linear-gradient(145deg, #fff4cf 0%, #ffefd0 100%);
}

.learn-hero .chapter-seal { color: #9a5e24; }

.audio-card { border-left: 8rpx solid #efb841; }
.text-card { border-left: 8rpx solid #76b982; }

.audio-symbol { background: #fff0bd; }
.text-symbol { background: #ddf3df; }

.learning-progress {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #eadac2;
}

.progress-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #765f54;
  font-size: 20rpx;
  font-weight: 650;
}

.progress-track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f0e5d4;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.audio-progress { background: #efb841; }
.text-progress { background: #76b982; }

/* 初版分层入场动画，使用显式 class 以便 TabBar 页面再次显示时重播。 */
.learn-page.page-enter-active {
  animation: pageEnter-learn 500ms ease-out;
}

.learn-page.page-enter-active .learn-hero {
  animation: headerSlideDown-learn 400ms ease-out 100ms both;
}

.learn-page.page-enter-active .section-caption,
.learn-page.page-enter-active .feature-list {
  animation: contentFadeUp-learn 500ms ease-out 150ms both;
}

.learn-page.page-enter-active .feature-card:nth-child(1) {
  animation: cardBounceIn-learn 550ms ease-out 200ms both;
}

.learn-page.page-enter-active .feature-card:nth-child(2) {
  animation: cardBounceIn-learn 550ms ease-out 320ms both;
}

@keyframes pageEnter-learn {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes headerSlideDown-learn {
  from { opacity: 0; transform: translateY(-40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes contentFadeUp-learn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes cardBounceIn-learn {
  0% { opacity: 0; transform: translateY(80rpx) scale(0.92); }
  60% { opacity: 1; transform: translateY(-12rpx) scale(1.02); }
  80% { transform: translateY(4rpx) scale(0.99); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .learn-page.page-enter-active,
  .learn-page.page-enter-active .learn-hero,
  .learn-page.page-enter-active .section-caption,
  .learn-page.page-enter-active .feature-list,
  .learn-page.page-enter-active .feature-card {
    animation: none;
  }
}
