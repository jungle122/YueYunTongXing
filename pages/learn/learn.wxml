<view class="hub-page learn-page {{isPageEntering ? 'page-enter-active' : ''}}">
  <view class="page-intro learn-hero">
    <text class="chapter-seal">第一章</text>
    <text class="intro-title">选一种喜欢的方式开始吧</text>
    <text class="intro-description">在童谣、陪伴和岭南故事里，自然认识粤语。</text>
    <text class="hero-ornament">♪</text>
  </view>

  <text class="section-caption">学习方式</text>
  <view class="feature-list">
    <view class="feature-card audio-card" bindtap="goAudio" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="进入音频学习">
      <view class="feature-main">
        <image class="feature-symbol audio-symbol" src="/static/ui/learn/音频学习.jpg" mode="aspectFit" />
        <view class="feature-copy">
          <text class="feature-title">音频学习</text>
          <text class="feature-description">听童谣、看歌词、录下自己的跟唱。</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="learning-progress">
        <view class="progress-info"><text>学习进度</text><text>{{audioProgress}}%</text></view>
        <view class="progress-track"><view class="progress-fill audio-progress" style="{{audioProgressStyle}}"></view></view>
      </view>
    </view>

    <view class="feature-card text-card" bindtap="goText" hover-class="soft-press" hover-stay-time="120" aria-role="button" aria-label="进入文字科普">
      <view class="feature-main">
        <image class="feature-symbol text-symbol" src="/static/ui/learn/文字科普.jpg" mode="aspectFit" />
        <view class="feature-copy">
          <text class="feature-title">文字科普</text>
          <text class="feature-description">了解童谣背后的岭南生活与传统文化。</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
      <view class="learning-progress">
        <view class="progress-info"><text>学习进度</text><text>{{textProgress}}%</text></view>
        <view class="progress-track"><view class="progress-fill text-progress" style="{{textProgressStyle}}"></view></view>
      </view>
    </view>
  </view>
</view>
