.elimination-game-page {
  min-height: 100vh;
  color: #49372f;
  background:
    radial-gradient(circle at 94% 4%, rgba(105, 160, 195, 0.17), transparent 24%),
    radial-gradient(circle at 3% 58%, rgba(232, 154, 82, 0.13), transparent 20%),
    #fff8eb;
  animation: gamePageEnter 380ms ease-out both;
}
.game-shell { min-height: 100vh; padding: 24rpx 28rpx 76rpx; box-sizing: border-box; }

.game-overview { min-height: 116rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; border: 2rpx solid #ead8bc; border-radius: 26rpx; background: rgba(255, 253, 246, 0.95); box-shadow: 0 10rpx 24rpx rgba(104, 66, 43, 0.08); box-sizing: border-box; }
.overview-copy { display: flex; flex-direction: column; }
.overview-kicker { color: #8a7568; font-size: 19rpx; font-weight: 750; letter-spacing: 1rpx; }
.overview-title { margin-top: 4rpx; color: #4d392f; font-size: 30rpx; font-weight: 900; }
.overview-stats { display: flex; align-items: center; }
.overview-stat { min-width: 76rpx; display: flex; flex-direction: column; align-items: center; }
.stat-number { color: #6092ad; font-size: 29rpx; font-weight: 900; font-variant-numeric: tabular-nums; }
.stat-label { margin-top: 2rpx; color: #9b8272; font-size: 18rpx; }
.stat-divider { width: 2rpx; height: 48rpx; margin: 0 8rpx; background: #eadcc9; }

.timer-card { margin-top: 18rpx; padding: 18rpx 22rpx; border: 2rpx solid #d7e4e8; border-radius: 22rpx; background: #f3fafb; }
.timer-copy { display: flex; justify-content: space-between; align-items: baseline; }
.timer-label { color: #67808a; font-size: 20rpx; font-weight: 800; }
.timer-value { color: #4f7889; font-size: 23rpx; font-weight: 900; font-variant-numeric: tabular-nums; }
.timer-track { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: #dbe9eb; }
.timer-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #8fc7c9, #5795b4); transition: width 300ms linear; }
.timer-danger { border-color: #e8c0b2; background: #fff3ed; }
.timer-danger .timer-value { color: #bf5d4d; }
.timer-danger .timer-fill { background: #cf6552; }

.message-card { min-height: 76rpx; margin-top: 18rpx; padding: 14rpx 18rpx; display: flex; align-items: center; border: 2rpx solid #e7d9c5; border-radius: 20rpx; background: #fffaf1; box-sizing: border-box; }
.message-symbol { width: 36rpx; height: 36rpx; margin-right: 12rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: #efe3d2; color: #8d725f; font-size: 18rpx; font-weight: 900; }
.message-text { flex: 1; color: #7b6254; font-size: 21rpx; line-height: 1.45; }
.message-card.success { border-color: #cce1c6; background: #f1f8ec; }
.message-card.success .message-symbol { background: #d6ead0; color: #4f8250; }
.message-card.error { border-color: #ebc8bc; background: #fff2ed; }
.message-card.error .message-symbol { background: #f2d8cf; color: #b8584a; }

.board-card { margin-top: 18rpx; padding: 24rpx 20rpx 20rpx; border: 2rpx solid #e7d5bb; border-radius: 28rpx; background: #fffdf7; box-shadow: 0 14rpx 30rpx rgba(91, 58, 40, 0.09); }
.board-heading { padding: 0 5rpx 18rpx; display: flex; align-items: baseline; justify-content: space-between; }
.board-title { color: #503c32; font-size: 26rpx; font-weight: 900; }
.board-hint { color: #a18a7a; font-size: 18rpx; }
.game-board { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; }
.game-cell { position: relative; min-width: 0; min-height: 128rpx; padding: 20rpx 8rpx 14rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 3rpx solid #d8e3df; border-radius: 20rpx; background: linear-gradient(145deg, #eef7f3, #dfeee9); color: #506a63; box-shadow: 0 5rpx 10rpx rgba(67, 91, 82, 0.08); box-sizing: border-box; transition: transform 160ms ease-out, opacity 260ms ease-out, background-color 160ms ease-out; }
.cell-corner { position: absolute; left: 8rpx; top: 6rpx; color: rgba(74, 94, 86, 0.38); font-size: 14rpx; font-weight: 900; }
.cell-word { overflow-wrap: anywhere; font-size: 21rpx; font-weight: 850; line-height: 1.35; text-align: center; }
.selected-mark { position: absolute; right: 7rpx; top: 6rpx; width: 25rpx; height: 25rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, 0.76); color: #b36045; font-size: 15rpx; font-weight: 900; }
.game-cell.selected { border-color: #e0a16e; background: linear-gradient(145deg, #fff1d8, #f5cf9e); color: #724c36; transform: translateY(-4rpx) scale(1.02); box-shadow: 0 9rpx 18rpx rgba(156, 95, 54, 0.16); }
.game-cell.matched { border-color: #a9cda6; background: #dcefd9; }
.game-cell.hidden { opacity: 0.12; pointer-events: none; transform: scale(0.9); box-shadow: none; }

.controls { margin-top: 20rpx; display: flex; gap: 14rpx; }
.game-btn { flex: 1; min-height: 82rpx; margin: 0; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 22rpx; font-size: 23rpx; font-weight: 850; line-height: 1; }
.game-btn::after { border: 0; }
.new-game-btn { background: #6599b2; color: #fff; box-shadow: 0 8rpx 18rpx rgba(70, 119, 143, 0.18); }
.hint-btn { border: 2rpx solid #e2c69f; background: #fff0d2; color: #88613d; }
.btn-icon { margin-right: 9rpx; font-size: 26rpx; line-height: 1; }
.game-btn:active { opacity: 0.72; transform: scale(0.98); }
.game-btn[disabled] { opacity: 0.48; }

@keyframes gamePageEnter { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 340px) { .game-shell { padding-left: 22rpx; padding-right: 22rpx; } .game-board { gap: 8rpx; } .game-cell { min-height: 116rpx; } .cell-word { font-size: 19rpx; } }
@media (prefers-reduced-motion: reduce) { .elimination-game-page, .game-cell, .timer-fill { animation: none; transition: none; } }
