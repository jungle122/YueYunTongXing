<view class="login-page">
  <view class="login-decoration login-cloud-1"></view>
  <view class="login-decoration login-cloud-2"></view>
  <view class="login-decoration login-flower-1">✿</view>
  <view class="login-decoration login-flower-2">❀</view>

  <view class="login-hero">
    <view class="hero-badge">粤语童谣时光屋</view>
    <text class="hero-title">建立你的学习角色</text>
    <text class="hero-subtitle">微信身份会自动识别学习角色，昵称可以随时修改</text>
  </view>

  <view wx:if="{{isRestoring}}" class="identity-loading-card">
    <view class="identity-loading-icon">☁</view>
    <text class="identity-loading-title">正在恢复学习资料</text>
    <text class="identity-loading-copy">无需输入账号或密码</text>
  </view>

  <view wx:else class="login-card">
    <view class="card-title-row">
      <text class="card-seal">微信身份</text>
      <text class="card-title">完善角色资料</text>
    </view>

    <view wx:if="{{identityError}}" class="identity-error">{{identityError}}</view>

    <view class="nickname-section">
      <text class="input-label">角色昵称（可重复、可随时修改）</text>
      <view class="nickname-input-wrap">
        <text class="input-icon">✏️</text>
        <input
          type="nickname"
          class="nickname-input"
          placeholder="输入昵称"
          placeholder-style="color:#b8a99a"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
          focus="{{nicknameFocused}}"
          maxlength="12"
        />
        <view class="wechat-nickname-action" bindtap="useWechatNickname">使用微信昵称</view>
      </view>
      <text class="nickname-helper">真机点击后，可从微信提供的昵称中快速选择</text>
    </view>

    <view class="avatar-section">
      <text class="input-label">选择头像</text>
      <view class="sticker-avatars">
        <view
          wx:for="{{stickerAvatars}}"
          wx:key="id"
          class="sticker-avatar-item {{selectedSticker === index ? 'sticker-selected' : ''}}"
          bindtap="selectSticker"
          data-index="{{index}}"
        >
          <image class="sticker-image" src="{{item.src}}" mode="aspectFill" />
          <text class="sticker-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="wechat-avatar-section">
      <button class="wechat-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <text class="wechat-btn-icon">📱</text>
        <text class="wechat-btn-text">使用微信头像</text>
      </button>
      <view wx:if="{{wechatAvatarUrl}}" class="wechat-preview">
        <image class="wechat-preview-img" src="{{wechatAvatarUrl}}" mode="aspectFill" />
        <text class="wechat-preview-text">已选择微信头像</text>
      </view>
    </view>

    <view class="login-btn-wrap">
      <view class="login-btn {{!nickname || isSaving ? 'login-btn-disabled' : ''}}" bindtap="handleLogin" hover-class="login-btn-press">
        <text class="login-btn-text">{{isSaving ? '正在保存...' : '保存资料 · 开始学习'}}</text>
      </view>
    </view>
  </view>

  <view class="login-footer">
    <text class="footer-text">角色资料与当前微信身份关联，无需记住昵称或密码</text>
  </view>
</view>
