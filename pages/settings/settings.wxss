.settings-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 94% 4%, rgba(244, 190, 80, 0.088), transparent 26%),
    radial-gradient(circle at 2% 42%, rgba(224, 126, 98, 0.04), transparent 20%),
    var(--color-bg);
  position: relative;
  overflow: hidden;
}

.settings-decoration {
  position: absolute;
  pointer-events: none;
}

.settings-cloud-1 {
  top: 50rpx;
  right: 30rpx;
  width: 100rpx;
  height: 40rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.5);
  opacity: 0.6;
}

.settings-cloud-2 {
  top: 120rpx;
  left: 20rpx;
  width: 70rpx;
  height: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.4);
  opacity: 0.5;
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(207, 104, 75, 0.1);
  border: 2rpx solid rgba(207, 104, 75, 0.2);
}

.back-arrow {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.page-title {
  font-size: 34rpx;
  font-weight: 850;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

.header-spacer {
  width: 60rpx;
}

.settings-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.settings-section {
  padding: 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}

.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

/* 头像区域 */
.avatar-section {
  text-align: center;
}

.current-avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.current-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #f1c96e;
  overflow: hidden;
  box-shadow: none;
}

.avatar-emoji-display {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffe8c2, #ffd7a8);
}

.avatar-emoji-large {
  font-size: 64rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffe8c2;
  font-size: 48rpx;
}

.avatar-options {
  text-align: left;
}

.option-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.avatar-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 10rpx;
  margin-bottom: 24rpx;
}

.avatar-choice-item {
  box-sizing: border-box;
  width: calc(25% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 6rpx;
  border-radius: 18rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.choice-selected {
  border-color: var(--color-primary);
  background: rgba(207, 104, 75, 0.08);
}

.choice-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-shadow: none;
}

.choice-name {
  font-size: 19rpx;
  color: var(--color-text);
  font-weight: 600;
}

.divider-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  position: relative;
}

.divider-line::before,
.divider-line::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: var(--color-border);
}

.divider-text {
  padding: 0 20rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.wechat-avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--color-wechat);
  border-radius: var(--radius-control);
  background: var(--color-wechat-soft);
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
}

.wechat-avatar-btn::after {
  border: none;
}

.wechat-icon {
  font-size: 28rpx;
}

.wechat-text {
  font-size: 26rpx;
  color: var(--color-wechat-text);
  font-weight: 700;
}

.wechat-preview-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: var(--color-wechat-soft);
  border: 2rpx solid var(--color-wechat-border);
}

.wechat-preview-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-wechat);
}

.wechat-hint {
  font-size: 22rpx;
  color: var(--color-wechat-text);
  font-weight: 600;
}

/* 输入框 */
.input-wrap {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  background: #fff9ed;
}

.input-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.settings-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 600;
}

/* 保存按钮 */
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  box-shadow: none;
 color: var(--color-white); }

.save-btn-press {
  opacity: 0.85;
  transform: scale(0.97);
}

.save-btn-disabled {
  opacity: 0.6;
}

.save-btn-text {
  font-size: 28rpx;
  font-weight: 750;
  color: var(--color-white);
  letter-spacing: 2rpx;
}

.account-note {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: rgba(255, 253, 245, 0.8);
  text-align: center;
}

.account-note-error {
  border-color: var(--color-error-border);
  background: var(--color-error-soft);
}

.wechat-nickname-action {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: var(--color-wechat-soft);
  color: var(--color-wechat-text);
  font-size: 19rpx;
  font-weight: 700;
}

.nickname-helper {
  display: block;
  margin-top: 10rpx;
  font-size: 19rpx;
  color: var(--color-text-muted);
}

.account-note-title,
.account-note-copy {
  display: block;
}

.account-note-title {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--color-text);
}

.account-note-copy {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

@media (max-width: 340px) {
  .settings-page { padding-left: 22rpx; padding-right: 22rpx; }
  .avatar-choices { gap: 10rpx; }
  .choice-image { width: 76rpx; height: 76rpx; }
}

/* 主操作统一使用品牌陶土红；按下和禁用状态与章节色分离。 */
.save-btn:active { background: var(--color-primary-pressed); }
.save-btn[disabled] { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }

.save-btn-disabled { background: var(--color-disabled-bg); color: var(--color-disabled-text); opacity: 1; }
.save-btn-disabled .save-btn-text { color: var(--color-disabled-text); }

.input-wrap:focus-within { border-color: var(--color-primary); }

.account-note-error .account-note-copy { color: var(--color-error); }
