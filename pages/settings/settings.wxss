.settings-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 94% 4%, rgba(244, 190, 80, 0.22), transparent 26%),
    radial-gradient(circle at 2% 42%, rgba(224, 126, 98, 0.1), transparent 20%),
    #fff7e8;
  position: relative;
  overflow: hidden;
}

.settings-decoration {
  position: absolute;
  pointer-events: none;
}

.settings-cloud-1 {
  top: 50rpx;
  right: 30rpx;
  width: 100rpx;
  height: 40rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.5);
  opacity: 0.6;
}

.settings-cloud-2 {
  top: 120rpx;
  left: 20rpx;
  width: 70rpx;
  height: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.4);
  opacity: 0.5;
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(207, 104, 75, 0.1);
  border: 2rpx solid rgba(207, 104, 75, 0.2);
}

.back-arrow {
  font-size: 30rpx;
  color: #cf684b;
  font-weight: 700;
}

.page-title {
  font-size: 34rpx;
  font-weight: 850;
  color: #49352d;
  letter-spacing: 2rpx;
}

.header-spacer {
  width: 60rpx;
}

.settings-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.settings-section {
  padding: 28rpx;
  border: 2rpx solid #ead5b5;
  border-radius: 28rpx;
  background: #fffdf5;
  box-shadow: 0 10rpx 24rpx rgba(104, 66, 43, 0.08);
}

.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: #49352d;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

/* 头像区域 */
.avatar-section {
  text-align: center;
}

.current-avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.current-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #f1c96e;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(104, 66, 43, 0.12);
}

.avatar-emoji-display {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffe8c2, #ffd7a8);
}

.avatar-emoji-large {
  font-size: 64rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffe8c2;
  font-size: 48rpx;
}

.avatar-options {
  text-align: left;
}

.option-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #634b40;
  margin-bottom: 16rpx;
}

.avatar-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 10rpx;
  margin-bottom: 24rpx;
}

.avatar-choice-item {
  box-sizing: border-box;
  width: calc(25% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 6rpx;
  border-radius: 18rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.choice-selected {
  border-color: #cf684b;
  background: rgba(207, 104, 75, 0.08);
}

.choice-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

.choice-name {
  font-size: 19rpx;
  color: #634b40;
  font-weight: 600;
}

.divider-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  position: relative;
}

.divider-line::before,
.divider-line::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #ead5b5;
}

.divider-text {
  padding: 0 20rpx;
  font-size: 20rpx;
  color: #a08d82;
}

.wechat-avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #07C160;
  border-radius: 16rpx;
  background: rgba(7, 193, 96, 0.06);
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
}

.wechat-avatar-btn::after {
  border: none;
}

.wechat-icon {
  font-size: 28rpx;
}

.wechat-text {
  font-size: 26rpx;
  color: #07C160;
  font-weight: 700;
}

.wechat-preview-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(7, 193, 96, 0.06);
  border: 2rpx solid rgba(7, 193, 96, 0.2);
}

.wechat-preview-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #07C160;
}

.wechat-hint {
  font-size: 22rpx;
  color: #07C160;
  font-weight: 600;
}

/* 输入框 */
.input-wrap {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border: 2rpx solid #e6cba8;
  border-radius: 18rpx;
  background: #fff9ed;
}

.input-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.settings-input {
  flex: 1;
  font-size: 26rpx;
  color: #49352d;
  font-weight: 600;
}

/* 设置行 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx dashed #eadbc4;
}

.setting-row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #49352d;
}

.settings-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid #e6cba8;
  border-radius: 14rpx;
  background: #fff9ed;
  font-size: 24rpx;
  color: #49352d;
  font-weight: 600;
}

.picker-arrow {
  font-size: 20rpx;
  color: #a08d82;
}

/* 保存按钮 */
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  border-radius: 45rpx;
  background: linear-gradient(135deg, #cf684b, #e8a87c);
  box-shadow: 0 10rpx 24rpx rgba(207, 104, 75, 0.25);
}

.save-btn-press {
  opacity: 0.85;
  transform: scale(0.97);
}

.save-btn-disabled {
  opacity: 0.6;
}

.save-btn-text {
  font-size: 28rpx;
  font-weight: 750;
  color: #fff;
  letter-spacing: 2rpx;
}

.account-note {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #ead5b5;
  border-radius: 20rpx;
  background: rgba(255, 253, 245, 0.8);
  text-align: center;
}

.account-note-error {
  border-color: #e6b09f;
  background: rgba(255, 241, 235, 0.9);
}

.wechat-nickname-action {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(7, 193, 96, 0.08);
  color: #07c160;
  font-size: 19rpx;
  font-weight: 700;
}

.nickname-helper {
  display: block;
  margin-top: 10rpx;
  font-size: 19rpx;
  color: #927263;
}

.account-note-title,
.account-note-copy {
  display: block;
}

.account-note-title {
  font-size: 23rpx;
  font-weight: 700;
  color: #634b40;
}

.account-note-copy {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #927263;
  line-height: 1.5;
}

@media (max-width: 340px) {
  .settings-page { padding-left: 22rpx; padding-right: 22rpx; }
  .avatar-choices { gap: 10rpx; }
  .choice-image { width: 76rpx; height: 76rpx; }
}
