.alin-3d-wrapper {
  position: absolute;
  right: 6rpx;
  bottom: -16rpx;
  width: 122rpx;
  height: 158rpx;
  z-index: 8;
  animation: float 3.4s ease-in-out infinite;
  pointer-events: none;
}
.alin-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 8rpx 10rpx rgba(85, 51, 34, 0.2));
}
.alin-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  background: rgba(255, 253, 245, 0.82);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(85, 51, 34, 0.15);
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .alin-3d-wrapper { animation: none; }
}
