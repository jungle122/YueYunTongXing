.alin-3d-wrapper {
  position: fixed;
  right: 20rpx;
  bottom: 120rpx;
  width: 140rpx;
  height: 140rpx;
  z-index: 999;
  animation: float 3s ease-in-out infinite;
}
.alin-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.alin-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}