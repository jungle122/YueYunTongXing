.ai-panel { margin: 28rpx 0; border: 2rpx solid var(--color-border, #ead8bc); border-radius: var(--radius-card, 24rpx); background: var(--color-surface, #fffef8); color: var(--color-text, #49352d); overflow: hidden; }
.ai-toggle { margin: 0; padding: 20rpx 24rpx; background: transparent; color: var(--color-primary-pressed, #8f3c29); font-size: 29rpx; text-align: left; line-height: 1.6; }
.ai-toggle::after, .ai-submit::after { border: 0; }
.ai-content { padding: 0 24rpx 24rpx; }
.ai-note, .ai-consent { display: block; color: var(--color-text-secondary, #765f54); font-size: 24rpx; line-height: 1.65; }
.ai-suggestions { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 18rpx 0; }
.ai-suggestions button { margin: 0; font-size: 24rpx; color: var(--color-text, #49352d); background: var(--color-surface-soft, #faf3e5); }
.ai-input { display: block; width: 100%; height: 150rpx; padding: 18rpx; box-sizing: border-box; border: 2rpx solid var(--color-border-strong, #cbb8a2); border-radius: var(--radius-control, 16rpx); font-size: 28rpx; line-height: 1.6; background: var(--color-white, #ffffff); }
.ai-consent { margin: 20rpx 0; }
.ai-submit { font-size: 28rpx; background: var(--color-primary, #a94736); color: var(--color-white, #ffffff); }
.ai-error { display: block; margin-top: 16rpx; font-size: 26rpx; color: var(--color-error, #9b2828); line-height: 1.6; }
.ai-answer { margin-top: 24rpx; }
.ai-answer-label { display: block; font-weight: 600; font-size: 26rpx; }
.ai-answer-text { display: block; margin: 12rpx 0; font-size: 29rpx; line-height: 1.85; white-space: pre-wrap; overflow-wrap: break-word; }

.ai-submit:active { background: var(--color-primary-pressed, #8f3c29); }
.ai-submit[disabled] { background: var(--color-disabled-bg, #efe2d0); color: var(--color-disabled-text, #806b60); }
.ai-input:focus { border-color: var(--color-primary, #a94736); }
